    "The program it starts is gone, and no installed app claims it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program, který položka spouští, už neexistuje a žádná nainstalovaná aplikace se k ní nehlásí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Programm, das es startet, ist nicht mehr da, und keine installierte App beansprucht es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El programa que inicia ya no está y ninguna app instalada lo reclama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme qu’il lance a disparu, et aucune app installée ne le revendique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma che avvia non c’è più e nessuna app installata lo riconosce come proprio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動するプログラムがなくなっていて、インストール済みのどのアプリのものでもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목이 시작하는 프로그램이 없어졌고, 이 항목을 소유한 설치된 앱도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het programma dat het start, is er niet meer, en geen enkele geïnstalleerde app eist het op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program, który ta rzecz uruchamia, zniknął, a żadna zainstalowana aplikacja się do niej nie przyznaje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O programa que ele inicia não existe mais, e nenhum app instalado o reivindica."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programul pe care îl pornește nu mai există și nicio aplicație instalată nu îl revendică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программы, которую он запускает, больше нет, и он не принадлежит ни одному установленному приложению."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmet som det startar finns inte längre, och ingen installerad app gör anspråk på det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlattığı program artık yok ve yüklü hiçbir uygulama onu sahiplenmiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Того, що він запускає, уже немає, і жодна інстальована програма не вважає його своїм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

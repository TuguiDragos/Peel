        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に確認されたときは“%@”によって署名されていましたが、現在は“%@”によって署名されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 확인했을 때는 %@의 서명이 있었지만, 지금은 %@의 서명이 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toen Peel de app voor het eerst zag, was die ondertekend door %@, en nu door %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Peel zobaczył ją pierwszy raz, była podpisana przez %@, a teraz jest podpisana przez %@."

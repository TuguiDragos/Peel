    "Instead of the accent picker, holding a letter types it again and again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místo nabídky znaků s diakritikou se při podržení písmene píše stále znovu totéž písmeno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Buchstaben gedrückt hältst, wird er immer wieder eingegeben, statt dass die Akzentauswahl erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vez de aparecer el selector de acentos, la letra que mantienes pulsada se escribe una y otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenir une lettre enfoncée la saisit à répétition, au lieu d’afficher le sélecteur d’accents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenendo premuta una lettera, la digiti più volte di seguito invece di far comparire il selettore degli accenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字キーを押し続けると、アクセント記号の候補が表示される代わりに、その文字が繰り返し入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자 키를 길게 누르면 악센트 선택기 대신 그 문자가 반복해서 입력됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een letter ingedrukt houdt, wordt die steeds opnieuw getypt, in plaats van dat de tekens met accenten verschijnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamiast menu znaków akcentowanych przytrzymanie litery wpisuje ją raz za razem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em vez de mostrar o seletor de acentos, manter uma letra pressionada a digita várias vezes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O literă ținută apăsată se tastează în mod repetat, în loc să deschidă selectorul de accente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удержании буквы она вводится снова и снова вместо меню символов с диакритическими знаками."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stället för att accentväljaren visas upprepas en bokstav om och om igen när du håller ned den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir harfi basılı tutmak, aksan seçiciyi açmak yerine o harfi tekrar tekrar yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замість меню символів із діакритичними знаками утримувана літера вводиться знову і знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住某个字母时会重复输入该字母，而不是显示重音字符选择器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住字母時會重複輸入該字母，而不是顯示重音符號選擇器。"
          }
        }
      }
    },

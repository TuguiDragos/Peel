    "Smaller files than PNG, with slightly less detail." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubory jsou menší než PNG a mají o něco méně detailů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleinere Dateien als PNG, mit etwas weniger Details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos más pequeños que en PNG, con algo menos de detalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des fichiers plus légers qu’en PNG, avec un peu moins de détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File più piccoli rispetto a PNG, con un po’ meno dettaglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNGよりファイルが小さくなり、細部はやや粗くなります。"

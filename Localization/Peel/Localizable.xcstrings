            "value" : "Peel kon de momentopnamen die op deze schijf worden bewaard niet opvragen, en die kunnen een deel van de schijfruimte innemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel nie mógł odczytać listy migawek przechowywanych na tym dysku, które mogą zajmować część jego miejsca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peel não conseguiu listar as capturas guardadas neste disco, que podem ocupar parte do seu espaço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel nu a putut lista instantaneele păstrate pe acest disc, care pot ocupa o parte din spațiul său."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel не удалось получить список снимков, хранящихся на этом диске, а они могут занимать часть его пространства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel kunde inte lista ögonblicksbilderna som sparas på den här skivan, och de kan ta upp en del av dess utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel, bu diskte tutulan ve diskin alanının bir kısmını kaplıyor olabilecek anlık görüntüleri listeleyemedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel не вдалося отримати список знімків, збережених на цьому диску, які можуть займати частину його місця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

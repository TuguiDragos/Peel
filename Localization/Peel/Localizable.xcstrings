    "Where Homebrew downloads the packages it upgrades. A cask comes from its maker’s own address." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtud Homebrew stahuje balíčky, které upgraduje. Cask pochází z vlastní adresy svého výrobce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von hier lädt Homebrew die Pakete, für die es ein Upgrade ausführt. Ein Cask kommt von der eigenen Adresse seines Herstellers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lugar desde el que Homebrew descarga los paquetes que actualiza. Un cask viene de la propia dirección de su fabricante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’endroit où Homebrew télécharge les paquets qu’il met à niveau. Un cask provient de l’adresse de son éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da dove Homebrew scarica i pacchetti che aggiorna. Un cask arriva dall’indirizzo del suo produttore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewがアップグレードするパッケージのダウンロード元です。caskは、その開発元自身のアドレスからダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew가 업그레이드하는 패키지를 다운로드하는 곳입니다. cask는 제작자의 자체 주소에서 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar Homebrew de pakketten downloadt die het upgradet. Een cask komt van het eigen adres van de maker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stąd Homebrew pobiera uaktualniane pakiety. Cask pochodzi z własnego adresu producenta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De onde o Homebrew baixa os pacotes para fazer upgrade. Um cask vem do endereço do próprio fabricante."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locul de unde Homebrew descarcă pachetele cărora le face upgrade. Un cask vine de la adresa proprie a producătorului său."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсюда Homebrew загружает пакеты, которые обновляет. Cask загружается с собственного адреса его производителя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Där Homebrew hämtar paketen som det uppgraderar. En cask kommer från tillverkarens egen adress."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew’un yükselttiği paketleri indirdiği yer. Bir cask, üreticisinin kendi adresinden gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звідси Homebrew викачує пакети, які оновлює. Cask викачується з власної адреси виробника."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew下载所升级软件包的地方。cask则来自其厂商自己的地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew下載升級套件的位置。每個cask則是從它的廠商自己的網址下載。"
          }
        }
      }
    },

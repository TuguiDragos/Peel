    "zsh keeps your last 50,000 commands and saves all of them, instead of keeping 2,000 and saving 1,000 as macOS sets it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh uchovává vašich posledních 50 000 příkazů a všechny je ukládá, místo aby uchovával 2 000 a ukládal 1 000, jak to nastavuje macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh behält deine letzten 50.000 Befehle und sichert sie alle, statt wie von macOS festgelegt 2.000 zu behalten und 1.000 zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh conserva tus últimos 50.000 comandos y los guarda todos, en vez de conservar 2000 y guardar 1000, como establece macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh garde vos 50 000 dernières commandes et les enregistre toutes, au lieu d’en garder 2 000 et d’en enregistrer 1 000 comme le définit macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh conserva i tuoi ultimi 50.000 comandi e li salva tutti, invece di conservarne 2.000 e salvarne 1.000 come stabilito da macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zshは、macOSのデフォルトのように2,000件を保持して1,000件を保存するのではなく、直近の50,000件のコマンドを保持し、そのすべてを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh는 macOS 설정대로 명령 2,000개를 유지하고 1,000개를 저장하는 대신, 최근 명령 50,000개를 유지하고 모두 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh onthoudt je laatste 50.000 commando's en bewaart ze allemaal, in plaats van er 2.000 te onthouden en 1.000 te bewaren zoals macOS het instelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh przechowuje Twoje ostatnie 50 000 poleceń i zachowuje je wszystkie, zamiast przechowywać 2000 i zachowywać 1000, jak ustawia to macOS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O zsh mantém os seus últimos 50.000 comandos e salva todos eles, em vez de manter 2.000 e salvar 1.000, como o macOS define."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh păstrează ultimele dvs. 50.000 de comenzi și le salvează pe toate, în loc să păstreze 2.000 și să salveze 1.000, așa cum stabilește macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh помнит Ваши последние 50 000 команд и сохраняет их все, а не помнит 2 000 и сохраняет 1 000, как задано в macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh behåller dina senaste 50 000 kommandon och sparar alla, i stället för att behålla 2 000 och spara 1 000, så som macOS ställer in det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh, macOS’in ayarladığı gibi 2.000 komut tutup 1.000 komut kaydetmek yerine son 50.000 komutunuzu tutar ve hepsini kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh памʼятає ваші останні 50 000 команд і зберігає їх усі, а не памʼятає 2 000 та зберігає 1 000, як налаштовано в macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh会保留你最近的50,000条命令并全部保存，而不是像macOS设定的那样保留2,000条、保存1,000条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zsh會保留你最近的50,000個指令並全部儲存，而不是依macOS的設定保留2,000個、儲存1,000個。"
          }
        }
      }
    },

        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel自身の最新リリースを確認します。新しいリリースが公開されたときに知らせますが、何もダウンロードしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel 자체의 최신 릴리즈 정보입니다. Peel은 새로운 버전이 출시되면 알려 주며, 아무것도 다운로드하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nieuwste versie van Peel zelf. Peel laat weten wanneer er een nieuwe is verschenen, en downloadt niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najnowsze wydanie samego Peel. Peel informuje, gdy pojawi się nowe, i niczego nie pobiera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão mais recente do próprio Peel. O Peel avisa quando uma nova está disponível e não baixa nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",

          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fanns fler mappar än Peel går igenom på en gång, så listan visar inte alla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel’in tek seferde baktığından daha fazla klasör vardı, bu yüzden bu liste hepsini içermiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папок більше, ніж Peel переглядає за один раз, тож цей список неповний."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件夹数量超出了Peel一次查看的上限，因此这份列表并不完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案夾數量超出Peel一次查看的範圍，因此這個列表並不完整。"
          }
        }
      }
    },
    "There’s no Trash to move this to." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neexistuje koš, do kterého by to šlo přesunout."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keinen Papierkorb, in den dies gelegt werden könnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna papelera a la que trasladar esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a aucune corbeille dans laquelle placer cet élément."
          }
        },
        "it" : {
          "stringUnit" : {

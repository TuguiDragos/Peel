    "%@ asks you again for what it was allowed to access. History can’t undo this." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ se vás znovu zeptá na přístup ke všemu, k čemu ho měla povolený. Historie tuto akci nemůže odvolat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ fragt dich erneut um Erlaubnis für alles, worauf die App zugreifen durfte. Über den Verlauf lässt sich das nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ volverá a preguntarte si puede acceder a lo que tenía permitido. Historial no puede deshacer esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vous redemandera ce à quoi il était autorisé à accéder. L’Historique ne peut pas annuler cette opération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ti chiederà di nuovo il permesso per ciò a cui le era consentito accedere. La Cronologia non può annullare questa operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”にアクセスを許可したものについて、アプリから再び許可を求められます。この操作は履歴から取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) 접근이 허용되었던 항목에 대해 다시 권한을 요청합니다. 이 작업은 기록에서 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vraagt je opnieuw om toestemming voor alles waartoe de app toegang had. Geschiedenis kan dit niet ongedaan maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ znów zapyta Cię o dostęp do wszystkiego, na co jej pozwolono. Historia nie może tego cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vai pedir de novo as permissões que tinha. O Histórico não pode desfazer isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația %@ vă va cere din nou permisiunea pentru ceea ce i s‑a permis să acceseze. Nu puteți anula acest lucru din Istoric."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение «%@» заново спросит Вас обо всем, к чему ему был разрешен доступ. История не сможет это отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ frågar dig igen om det som den fick komma åt. Historik kan inte ångra det här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, erişmesine izin verilenler için sizden yeniden izin ister. Geçmiş bunu geri alamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма «%@» знову запитає вас про те, до чого їй було дозволено доступ. Історія не зможе цього відмінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于之前获准访问的内容，“%@”会重新征求你的许可。“历史记录”无法撤销此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於先前獲准取用的項目，「%@」會再次向你詢問。「歷史記錄」無法還原此動作。"
          }
        }
      }
    },

    "Backups" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zálohy"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copias de seguridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

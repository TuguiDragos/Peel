    "ssh asks for a key’s passphrase once, saves it in your keychain, and adds the key to the agent." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh se na přístupové heslo ke klíči zeptá jen jednou, uloží ho do vašeho svazku klíčů a přidá klíč do agenta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh fragt einmal nach der Passphrase eines Schlüssels, sichert sie in deinem Schlüsselbund und fügt den Schlüssel dem Agenten hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh pide una sola vez la frase de contraseña de una clave, la guarda en tu llavero y añade la clave al agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh demande une seule fois la phrase secrète d’une clé, l’enregistre dans votre trousseau et ajoute la clé à l’agent ssh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh chiede una sola volta la frase chiave che protegge una chiave, la salva nel portachiavi e aggiunge la chiave all’agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sshは鍵のパスフレーズを一度だけ尋ね、キーチェーンに保存して、鍵をエージェントに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh가 키 암호를 한 번만 묻고 키체인에 저장한 다음, 키를 에이전트에 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh vraagt één keer om de wachtzin van een sleutel, bewaart die in je sleutelhanger en voegt de sleutel toe aan de agent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh pyta o hasło klucza tylko raz, zachowuje je w Twoim pęku kluczy i dodaje klucz do agenta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ssh pede a frase-senha de uma chave uma única vez, salva essa frase-senha nas suas chaves e adiciona a chave ao agente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh cere o singură dată fraza de acces a unei chei, o salvează în portcheiul dvs. și adaugă cheia în agent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh один раз запрашивает кодовую фразу ключа, сохраняет ее в Вашей связке ключей и добавляет ключ в агент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh frågar efter en nyckels lösenfras en gång, sparar den i din nyckelring och lägger till nyckeln i agenten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh, bir anahtarın parolasını bir kez sorar, parolayı anahtar zincirinize kaydeder ve anahtarı SSH aracısına ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh один раз запитує фразу-пароль ключа, зберігає її у вашій вʼязці ключів і додає ключ до агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh只会询问一次密钥的密码短语，将其储存在你的钥匙串中，并将该密钥添加到ssh-agent。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh只會詢問一次密鑰的密語，將它儲存在你的鑰匙圈中，並將密鑰加入代理程式。"
          }
        }
      }
    },

    "Terminal opens a shell other than zsh, so these settings don’t apply." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminál otevírá jiný shell než zsh, takže se tato nastavení neuplatní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal öffnet eine andere Shell als zsh, daher gelten diese Einstellungen nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal abre una shell distinta de zsh, así que estos ajustes no se aplican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal ouvre un autre shell que zsh : ces réglages ne s’appliquent donc pas."

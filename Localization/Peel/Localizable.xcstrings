    "Your %@ sets its own prompt after Peel’s line, so zsh shows that one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš soubor %@ nastavuje vlastní výzvu až za řádkem Peelu, takže zsh zobrazuje tu vaši."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Datei %@ legt nach der Zeile von Peel eine eigene Eingabeaufforderung fest, daher zeigt zsh diese an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu %@ establece su propio indicador después de la línea de Peel, así que zsh muestra ese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fichier %@ définit sa propre invite de commande après la ligne de Peel : c’est donc celle-ci que zsh affiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo file %@ imposta un proprio prompt dopo la riga di Peel, quindi zsh mostra quel prompt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの%@は、Peelのファイルを読み込む行より後で独自のプロンプトを設定しているため、zshはそちらのプロンプトを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 %@ 파일이 Peel의 줄 뒤에서 자체 프롬프트를 설정하므로 zsh는 그 프롬프트를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

            "value" : "Als Peel sie zum ersten Mal sah, war sie von %@ signiert, jetzt ist sie von %@ signiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez que se vio, la firmaba %@, y ahora la firma %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk Alanı buna dokunmaz: onu oluşturan uygulama neyin hâlâ gerekli olduğunu bilir."
          }
        },
        "uk" : {
          "stringUnit" : {

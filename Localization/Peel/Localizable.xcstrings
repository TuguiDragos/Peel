    "%@’s privacy permissions were reset before the move." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprávnění aplikace %@ pro soukromé údaje byla před přesunem resetována."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenschutzberechtigungen von „%@“ wurden vor dem Verschieben zurückgesetzt."

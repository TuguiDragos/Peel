            "state" : "translated",
            "value" : "Schließe das Volume an, um die Objekte aus seinem Papierkorb zurückzulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el disco para restaurarlos desde su papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez le disque pour les remettre à leur place depuis sa corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il disco per ripristinarli dal suo Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクを接続すると、そのゴミ箱から戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 디스크의 휴지통에서 되돌려 놓으려면 디스크를 연결하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit de schijf aan om ze terug te zetten uit de prullenmand van die schijf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz ten dysk, aby przywrócić je z jego Kosza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o disco para colocá-los de volta a partir do Lixo dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați discul pentru a le pune înapoi din Coșul acestuia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите диск, чтобы восстановить их из его Корзины."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut skivan för att lägga tillbaka dem från dess papperskorg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onları diskin kendi Çöp Sepeti’nden yerine koymak için diski bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підʼєднайте диск, щоб повернути їх із його Смітника."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接该磁盘，即可将它们从其废纸篓中放回原处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接該磁碟，即可從它的「垃圾桶」還原這些項目。"
          }
        }
      }
    },

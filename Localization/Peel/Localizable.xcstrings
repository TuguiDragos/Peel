    "These tools install with Homebrew. Run this in Terminal: its script says what it will do and waits before doing it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto nástroje se instalují pomocí Homebrew. Spusťte tento příkaz v Terminálu: jeho skript vypíše, co udělá, a než to provede, počká."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

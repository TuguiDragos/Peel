        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados ítems en una sola solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop d’éléments dans une seule requête."

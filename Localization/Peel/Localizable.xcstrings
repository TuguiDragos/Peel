        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번의 요청에 항목이 너무 많습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel onderdelen in één verzoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele rzeczy w jednym żądaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itens demais em uma só solicitação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prea multe articole într‑o singură solicitare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много объектов в одном запросе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För många objekt i en och samma begäran."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir istekte çok fazla öğe var."
          }
        },
        "uk" : {

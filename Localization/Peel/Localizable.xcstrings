    "It was first seen signed by %@, and is signed by %@ now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprvé byla zaznamenána s podpisem %@, teď ji podepisuje %@."

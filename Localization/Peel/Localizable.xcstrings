    "Something else was at that path by the time it moved. It is in the Trash as %@, and Finder can put it back." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V době přesunu už na tomto místě bylo něco jiného. Je to v koši pod názvem %@ a Finder to může vrátit zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als das Objekt verschoben wurde, lag an diesem Pfad schon etwas anderes. Dieses liegt jetzt als „%@“ im Papierkorb, und der Finder kann es zurücklegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cuando se hizo el traslado, en esa ruta había otra cosa. Está en la papelera como %@, y el Finder puede sacarla de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autre chose se trouvait à cet emplacement au moment du déplacement. Cet élément est dans la corbeille sous le nom %@, et le Finder peut le remettre en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento dello spostamento, in quel percorso c’era qualcos’altro. È nel Cestino come %@, e il Finder può ripristinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動した時点で、そのパスには別のものがありました。それは“%@”としてゴミ箱にあり、Finderで戻すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동할 때 해당 경로에 다른 항목이 있었습니다. 그 항목은 휴지통에 ‘%@’(이)라는 이름으로 있으며, Finder에서 되돌려 놓을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er stond iets anders op dat pad op het moment dat het werd verplaatst. Het staat in de prullenmand als %@, en Finder kan het terugzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W chwili przenoszenia pod tą ścieżką było coś innego. Jest w Koszu jako %@ i Finder może to przywrócić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havia outra coisa nesse caminho quando ele foi movido. Está no Lixo como %@, e o Finder pode colocá-lo de volta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când a avut loc mutarea, la acea cale se afla altceva. Acel element se află acum în Coș sub numele %@, iar Finder îl poate pune înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "К моменту перемещения по этому пути находилось что-то другое. Оно в Корзине под именем «%@», и Finder может его восстановить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något annat fanns på den sökvägen när det flyttades. Det ligger i papperskorgen som %@, och Finder kan lägga tillbaka det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taşındığı sırada o yolda başka bir şey vardı. Çöp Sepeti’nde %@ adıyla duruyor ve Finder onu yerine koyabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На момент переміщення за цим шляхом було вже щось інше. Воно в Смітнику під назвою «%@», і Finder може його повернути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动时，该路径上已是其他项目。它在废纸篓中名为“%@”，“访达”可以将其放回原处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動時，該路徑上已經是另一個項目。它以「%@」的名稱存放在「垃圾桶」中，Finder可以將它還原。"
          }
        }
      }
    },
    "Something has turned sleep off altogether, even with the lid closed. It survives a restart and System Settings doesn’t show it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco úplně vypnulo režim spánku, a to i při zavřeném víku. Vydrží to i restart a Nastavení systému to nezobrazuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas hat den Ruhezustand vollständig deaktiviert, selbst bei geschlossenem Deckel. Das bleibt auch nach einem Neustart so, und die Systemeinstellungen zeigen es nicht an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo ha desactivado el reposo por completo, incluso con la tapa cerrada. Se mantiene tras reiniciar y Ajustes del Sistema no lo muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose a complètement désactivé la suspension d’activité, même couvercle fermé. Ce réglage persiste après un redémarrage, et Réglages Système ne l’affiche pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa ha disattivato del tutto lo standby, anche con lo schermo chiuso. L’impostazione resta anche dopo un riavvio e Impostazioni di Sistema non la mostra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何かがスリープを完全にオフにしていて、Macを閉じていてもスリープしません。この状態は再起動後も続き、システム設定には表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무언가가 잠자기를 완전히 꺼 두어 덮개를 닫아도 잠자기 상태로 전환되지 않습니다. 이 설정은 재시동 후에도 유지되며 시스템 설정에는 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets heeft de sluimerstand volledig uitgeschakeld, zelfs als de computer gesloten is. Dit blijft ook na een herstart zo en Systeeminstellingen toont het niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś całkowicie wyłączyło usypianie, nawet przy zamkniętej pokrywie. Utrzymuje się to po ponownym uruchomieniu, a Ustawienia systemowe tego nie pokazują."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo desativou o repouso por completo, mesmo com a tampa fechada. Isso persiste depois de reiniciar, e os Ajustes do Sistema não o mostram."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceva a dezactivat complet adormirea, chiar și cu capacul închis. Starea aceasta rezistă la repornire, iar Configurări sistem nu o afișează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то полностью отключило режим сна, даже при закрытой крышке. Это сохраняется после перезагрузки, и Системные настройки этого не показывают."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något har stängt av viloläget helt, även när locket är stängt. Det finns kvar efter en omstart, och Systeminställningar visar det inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şey uyku modunu, kapak kapalıyken bile tamamen kapatmış. Bu durum yeniden başlatmadan sonra da sürer ve Sistem Ayarları bunu göstermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось повністю вимкнуло режим сну, навіть коли кришку закрито. Це зберігається після перезапуску, і Системні параметри цього не показують."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个程序完全关闭了睡眠，即使合上机盖也不会睡眠。重新启动后此设置依然有效，而且“系统设置”中不会显示它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有東西完全關閉了睡眠功能，即使上蓋關閉也不會睡眠。此設定在重新開機後仍然有效，而且「系統設定」中不會顯示。"
          }
        }
      }
    },
    "Something in this project changed in the last 7 days, so none of it is selected for you." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto projektu se za posledních 7 dní něco změnilo, a proto z něj Peel za vás nic nevybral."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Projekt hat sich in den letzten 7 Tagen etwas geändert, daher wird nichts davon für dich ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo de este proyecto ha cambiado en los últimos 7 días, así que no se selecciona nada de él por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose a changé dans ce projet ces 7 derniers jours : rien n’y est donc sélectionné à votre place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa in questo progetto è cambiato negli ultimi 7 giorni, quindi nulla viene selezionato al posto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトの何かが過去7日間に変更されたため、どれも自動では選択されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로젝트의 무언가가 최근 7일 이내에 변경되었으므로 아무것도 미리 선택되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is in de afgelopen 7 dagen iets in dit project gewijzigd, dus niets ervan is voor je geselecteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś w tym projekcie zmieniło się w ciągu ostatnich 7 dni, więc nic z niego nie jest zaznaczane za Ciebie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo neste projeto mudou nos últimos 7 dias, então o Peel não seleciona nada dele por você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceva din acest proiect s‑a modificat în ultimele 7 zile, așa că nimic din el nu este selectat pentru dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За последние 7 дней в этом проекте что-то изменилось, поэтому из него ничего не выбрано за Вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något i det här projektet har ändrats de senaste 7 dagarna, så inget av det är markerat åt dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu projede son 7 günde bir şey değişti, bu yüzden hiçbir kısmı sizin yerinize seçilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось у цьому проєкті змінилося за останні 7 днів, тож Peel нічого з нього не вибирає за вас."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目中有内容在过去7天内发生了更改，因此不会替你选择其中的任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此計畫案中有內容在過去7天內變更過，因此不會替你選取其中任何項目。"
          }
        }
      }
    },
    "Something is already there, and Peel never replaces it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už tam něco je a Peel to nikdy nenahrazuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dort befindet sich bereits etwas, und Peel ersetzt es nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay algo ahí, y Peel nunca lo reemplaza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose s’y trouve déjà, et Peel ne le remplace jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lì c’è già qualcosa, e Peel non lo sostituisce mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そこにはすでに別のものがあり、Peelがそれを置き換えることは決してありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그곳에 이미 다른 항목이 있으며, Peel은 그 항목을 절대 대치하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat daar al iets, en Peel vervangt dat nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś już tam jest, a Peel nigdy tego nie zastępuje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já há algo lá, e o Peel nunca o substitui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acolo se află deja ceva, iar Peel nu îl înlocuiește niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Там уже что-то есть, и Peel никогда это не заменяет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något finns redan där, och Peel ersätter det aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orada zaten bir şey var ve Peel var olanın üzerine asla yazmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Там уже щось є, а Peel ніколи цього не замінює."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那里已有其他项目，Peel绝不会替换它。"

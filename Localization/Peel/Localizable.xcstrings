    "A whole home folder or disk is too much to search. Choose the folder your projects are in." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celá domovská složka nebo disk je na prohledání příliš mnoho. Zvolte složku, ve které máte projekty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ganzer Benutzerordner oder ein ganzes Volume ist zu viel für die Suche. Wähle den Ordner, in dem deine Projekte liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carpeta de inicio o un disco entero es demasiado para buscar. Elige la carpeta donde están tus proyectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dossier de départ ou un disque entier est trop vaste pour être parcouru. Choisissez le dossier qui contient vos projets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’intera cartella Inizio o un intero disco è troppo per una ricerca. Scegli la cartella in cui si trovano i tuoi progetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームフォルダ全体やディスク全体は、検索するには広すぎます。プロジェクトがあるフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 폴더나 디스크 전체는 검색하기에 너무 큽니다. 프로젝트가 있는 폴더를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een hele thuismap of schijf is te veel om te doorzoeken. Kies de map waarin je projecten staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cały folder domowy lub dysk to za dużo do przeszukania. Wybierz folder, w którym są Twoje projekty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pasta pessoal ou um disco inteiro é demais para buscar. Escolha a pasta onde estão os seus projetos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dosar de reședință întreg sau un disc întreg înseamnă prea mult pentru căutare. Alegeți dosarul în care se află proiectele dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вся папка пользователя или весь диск слишком велики для поиска. Выберите папку, где находятся Ваши проекты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hel hemmapp eller skiva är för mycket att söka igenom. Välj mappen där dina projekt finns."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün bir ana klasör veya disk, aramak için çok büyük. Projelerinizin bulunduğu klasörü seçin."
          }
        },
        "uk" : {
          "stringUnit" : {

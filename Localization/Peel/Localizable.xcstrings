        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel scrie aceste configurări într‑un fișier propriu, pe care zsh îl citește. Dezactivarea uneia o scoate din acel fișier, iar fișierul dvs. ~/.zshrc rămâne așa cum este."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel записывает эти параметры в собственный файл, который читает zsh. Если выключить параметр, Peel уберет его из этого файла, а Ваш файл ~/.zshrc останется без изменений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

    "Commands such as `git branch` and `git tag` show their lists in columns when the window has room." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příkazy jako `git branch` a `git tag` zobrazují své seznamy ve sloupcích, když je v okně dost místa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehle wie `git branch` und `git tag` zeigen ihre Listen in Spalten an, wenn das Fenster genug Platz hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comandos como `git branch` y `git tag` muestran sus listas en columnas cuando la ventana tiene espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes comme `git branch` et `git tag` affichent leurs listes en colonnes lorsque la fenêtre est assez large."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandi come `git branch` e `git tag` mostrano i loro elenchi in colonne quando la finestra ha spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`git branch`や`git tag`などのコマンドは、ウインドウの幅に余裕があれば、一覧を複数列で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우에 공간이 있으면 `git branch`, `git tag` 같은 명령이 목록을 여러 열로 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando's zoals `git branch` en `git tag` tonen hun lijsten in kolommen als het venster daar ruimte voor heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polecenia takie jak `git branch` i `git tag` pokazują swoje listy w kolumnach, gdy okno ma na to miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos como `git branch` e `git tag` mostram as listas em colunas quando há espaço na janela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comenzile precum `git branch` și `git tag` își afișează listele pe coloane când există loc în fereastră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Такие команды, как `git branch` и `git tag`, выводят свои списки по столбцам, если в окне хватает места."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommandon som `git branch` och `git tag` visar sina listor i kolumner när fönstret har plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`git branch` ve `git tag` gibi komutlar, pencerede yer olduğunda listelerini sütunlar hâlinde gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Такі команди, як `git branch` і `git tag`, показують свої списки стовпцями, коли у вікні вистачає місця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`git branch`和`git tag`等命令会在窗口空间足够时分栏显示其列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`git branch`和`git tag`等指令會在視窗空間足夠時，以直欄顯示其列表。"
          }
        }
      }
    },

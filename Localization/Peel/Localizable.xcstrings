            "value" : "다른 패키지에 필요하기 때문에 Homebrew가 설치한 항목입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew heeft dit geïnstalleerd omdat een ander pakket het nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew zainstalował ten pakiet, ponieważ potrzebuje go inny pakiet."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Homebrew instalou este pacote porque outro precisa dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew a instalat acest pachet deoarece un alt pachet are nevoie de el."
          }
        },
        "ru" : {

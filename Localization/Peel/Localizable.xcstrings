    "Git remembers how you resolved a conflict and resolves the same conflict the same way next time." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git si zapamatuje, jak jste konflikt vyřešili, a stejný konflikt příště vyřeší stejně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git merkt sich, wie du einen Konflikt gelöst hast, und löst denselben Konflikt beim nächsten Mal genauso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git recuerda cómo resolviste un conflicto y resuelve el mismo conflicto de la misma forma la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git mémorise la façon dont vous avez résolu un conflit et résout ce même conflit de la même manière la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git ricorda come hai risolto un conflitto e la volta successiva risolve lo stesso conflitto nello stesso modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitは、コンフリクトをどのように解決したかを記憶し、次に同じコンフリクトが起きたときに同じ方法で解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git이 충돌을 해결한 방법을 기억했다가, 다음에 같은 충돌이 생기면 같은 방법으로 해결합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git onthoudt hoe je een conflict hebt opgelost en lost hetzelfde conflict de volgende keer op dezelfde manier op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git zapamiętuje, jak rozwiązano konflikt, i następnym razem rozwiązuje taki sam konflikt w ten sam sposób."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Git lembra como você resolveu um conflito e resolve o mesmo conflito do mesmo jeito da próxima vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git reține cum ați rezolvat un conflict și rezolvă același conflict la fel data viitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git запоминает, как Вы разрешили конфликт, и в следующий раз разрешает такой же конфликт так же."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git kommer ihåg hur du löste en konflikt och löser samma konflikt på samma sätt nästa gång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git, bir çakışmayı nasıl çözdüğünüzü hatırlar ve aynı çakışmayı bir dahaki sefere aynı şekilde çözer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git запамʼятовує, як ви розвʼязали конфлікт, і наступного разу розвʼязує такий самий конфлікт так само."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git会记住你解决冲突的方式，下次遇到相同的冲突时会以相同的方式解决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git會記住你解決衝突的方式，下次遇到相同的衝突時以同樣方式解決。"
          }
        }
      }
    },
    "Give Peel Full Disk Access in System Settings to see what iCloud files are kept on this Mac." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li vidět, které soubory z iCloudu jsou uložené v tomto Macu, udělte Peelu v Nastavení systému plný přístup k disku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Peel in den Systemeinstellungen Festplattenvollzugriff, um zu sehen, welche iCloud-Dateien auf diesem Mac gespeichert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a Peel acceso total al disco en Ajustes del Sistema para ver qué archivos de iCloud se guardan en este Mac."

    "macOS didn’t list the agents and daemons that apps added, so some may be missing here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém macOS neuvedl agenty a démony, které aplikace přidaly, takže někteří z nich mohou v seznamu chybět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat die von Apps hinzugefügten Agenten und Daemons nicht aufgeführt, daher fehlen hier möglicherweise einige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha enumerado los agentes y demonios que las apps han añadido, así que puede que aquí falten algunos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas listé les agents et les démons que les apps ont ajoutés : certains peuvent donc manquer ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha elencato gli agenti e i daemon aggiunti dalle app, quindi qui potrebbero mancarne alcuni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが追加したエージェントとデーモンをmacOSが一覧にしなかったため、ここでは一部が欠けている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 앱에서 추가한 에이전트와 데몬을 나열하지 않았으므로 그중 일부가 여기에서 누락되었을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS heeft de agents en daemons niet vermeld die door apps zijn toegevoegd, dus sommige ontbreken hier mogelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nie podał, jakie agenty i demony dodały aplikacje, więc może tu brakować niektórych z nich."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não listou os agentes e daemons que os apps adicionaram, então alguns podem estar faltando aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nu a listat agenții și daemonii adăugați de aplicații, așa că unii ar putea lipsi de aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не сообщила, какие агенты и демоны добавлены приложениями, поэтому некоторые из них могут здесь отсутствовать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS listade inte de agenter och daemons som appar har lagt till, så vissa kan saknas här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, uygulamaların eklediği aracıları ve arka plan programlarını listelemedi, bu yüzden bazıları burada eksik olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не перелічила агентів і демонів, доданих програмами, тож деяких із них тут може бракувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS没有列出App添加的代理和监控程序，因此这里可能缺少其中一些。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS沒有列出App加入的代理程式和服務程式，因此這裡可能缺少其中一些。"
          }
        }
      }
    },

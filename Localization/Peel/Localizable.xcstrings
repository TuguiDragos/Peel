          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを閉じた後も、Peelはメニューバーに常駐し、各ツールの検出結果と待機中のアップデートを表示します。これをオフにすると、ウインドウを閉じたときにPeelが終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {

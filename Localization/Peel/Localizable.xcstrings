        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel會在你關閉其視窗後保留在選單列中，並顯示各工具找到的內容和等待中的更新項目。若未開啟此選項，Peel會在你關閉其視窗時結束。"
          }

    "Privacy permissions were reset. %@ asks you again the next time it needs them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprávnění pro soukromé údaje byla resetována. Aplikace %@ se vás znovu zeptá, až je bude příště potřebovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenschutzberechtigungen wurden zurückgesetzt. „%@“ fragt dich erneut, wenn die App das nächste Mal Zugriff benötigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han restablecido los permisos de privacidad. %@ volverá a preguntarte la próxima vez que los necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations de confidentialité ont été réinitialisées. %@ vous les redemandera la prochaine fois qu’il en aura besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le autorizzazioni per la privacy sono state reimpostate. %@ ti chiederà di nuovo il permesso la prossima volta che ne avrà bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー権限はリセットされました。次に必要になったときに、“%@”から再び許可を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호 권한이 재설정되었습니다. 다음에 필요할 때 ‘%@’이(가) 다시 권한을 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacytoestemmingen zijn opnieuw ingesteld. %@ vraagt je weer om toestemming de volgende keer dat de app ze nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyzerowano uprawnienia prywatności. Aplikacja %@ znów Cię zapyta, gdy następnym razem będzie ich potrzebować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões de privacidade foram redefinidas. %@ vai pedir de novo na próxima vez que precisar delas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permisiunile de intimitate au fost resetate. Aplicația %@ vă va întreba din nou data viitoare când va avea nevoie de ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешения на доступ сброшены. Приложение «%@» спросит Вас заново, когда ему в следующий раз понадобится доступ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integritetsbehörigheterna nollställdes. %@ frågar dig igen nästa gång den behöver dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilik izinleri sıfırlandı. %@, bir dahaki sefere bunlara ihtiyaç duyduğunda sizden yeniden izin ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволи приватності скинуто. Програма «%@» знову запитає вас, коли вони їй знадобляться наступного разу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私权限已重置。“%@”下次需要时会重新征求你的许可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱私權限已重置。「%@」下次需要時會再次向你詢問。"
          }
        }
      }
    },
    "Privacy permissions weren’t reset." : {
      "localizations" : {

    "It was first seen signed by %@. A copy someone has changed looks like this, and so does one built from source." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprvé byla zaznamenána s podpisem %@. Tak vypadá kopie, kterou někdo změnil, a stejně tak kopie sestavená ze zdrojového kódu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Peel sie zum ersten Mal sah, war sie von %@ signiert. So sieht eine Kopie aus, die jemand verändert hat, und ebenso eine, die aus dem Quellcode erstellt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez que se vio, la firmaba %@. Así se ve una copia que alguien ha modificado, y también una compilada a partir del código fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel l’a d’abord vue signée par %@. Une copie modifiée par quelqu’un se présente ainsi, tout comme une copie compilée à partir du code source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima volta risultava firmata da %@. Una copia modificata da qualcuno appare così, e anche una compilata dal codice sorgente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に確認されたときは“%@”によって署名されていました。誰かが変更したコピーはこのように見えます。ソースからビルドしたものも同様です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 확인했을 때는 %@의 서명이 있었습니다. 누군가 변경한 복사본이나 소스에서 직접 빌드한 복사본이 이렇게 보입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toen Peel de app voor het eerst zag, was die ondertekend door %@. Zo ziet een kopie eruit die iemand heeft gewijzigd, en ook een die vanuit de broncode is gebouwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Peel zobaczył ją pierwszy raz, była podpisana przez %@. Tak wygląda kopia, którą ktoś zmienił, a także kopia skompilowana ze źródeł."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando foi visto pela primeira vez, estava assinado por %@. Uma cópia que alguém alterou fica assim, e uma compilada a partir do código-fonte também."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când a fost văzută prima dată, era semnată de %@. Așa arată o copie modificată de cineva și tot așa arată una compilată din codul sursă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда Peel впервые его увидел, оно было подписано разработчиком %@. Так выглядит копия, которую кто-то изменил, а также копия, собранная из исходного кода."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Första gången Peel såg den var den signerad av %@. En kopia som någon har ändrat ser ut så här, och det gör även en som har byggts från källkod."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk görüldüğünde %@ tarafından imzalanmıştı. Birinin değiştirdiği bir kopya böyle görünür, kaynak koddan derlenmiş bir kopya da."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уперше її було помічено з підписом %@. Так виглядає копія, яку хтось змінив, а також копія, зібрана з вихідного коду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初发现它时，它由%@签名。被他人修改过的副本会是这种情况，从源代码构建的副本也是如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次看到此App時，它由%@簽署。遭人修改過的副本會呈現這種情況，從原始碼建置的副本也是如此。"
          }
        }
      }
    },

    "Choose folders and scan. Peel compares contents, so only exact copies are found, folders included." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte složky a prohledejte je. Peel porovnává obsah, takže najde jen přesné kopie, včetně složek."
          }
        },
        "de" : {
          "stringUnit" : {

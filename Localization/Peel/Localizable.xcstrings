          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew löscht Folgendes endgültig: die aufbewahrten Downloads und alten Versionen sowie alle Formulae, die nur für etwas da waren, das nicht mehr vorhanden ist. Nichts wird in den Papierkorb gelegt, und im Verlauf lässt sich nichts davon zurücklegen."
          }
        },
        "es" : {

    "Allow Peel in System Settings under Login Items & Extensions." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte Peel v Nastavení systému v části Aktivace položek a rozšíření při přihlášení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Peel in den Systemeinstellungen unter „Anmeldeobjekte & Erweiterungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da permiso a Peel en Ajustes del Sistema, en Ítems de inicio y extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Peel dans Réglages Système, sous Ouverture et extensions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizza Peel in Impostazioni di Sistema, in “Elementi login ed estensioni”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定の“ログイン項目と機能拡張”でPeelを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정의 로그인 항목 및 확장 프로그램에서 Peel을 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Peel toe in Systeeminstellingen onder 'Inlogonderdelen en extensies'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Ustawieniach systemowych pozwól na działanie Peel w sekcji Rzeczy i rozszerzenia otwierane podczas logowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Peel nos Ajustes do Sistema, em Itens de Início de Sessão e Extensões."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți Peel în Configurări sistem, la Lansare la login și extensii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Peel в Системных настройках, в разделе «Объекты входа и расширения»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

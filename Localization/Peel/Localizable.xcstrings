          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された設定の一部を戻せませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 설정을 모두 되돌려 놓지는 못했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

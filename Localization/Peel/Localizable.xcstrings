        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accordez à Peel l’accès complet au disque dans Réglages Système pour voir quels fichiers iCloud sont conservés sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedi a Peel l’accesso completo al disco in Impostazioni di Sistema per vedere quali file di iCloud sono conservati su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacに保存されているiCloudファイルを確認するには、システム設定でPeelにフルディスクアクセスを許可してください。"
          }
        },
        "ko" : {

        }
      }
    },
    "Spaces a command doesn’t need are taken out before it is saved." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezery, které příkaz nepotřebuje, se před uložením odstraní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leerzeichen, die ein Befehl nicht braucht, werden vor dem Sichern entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los espacios que un comando no necesita se quitan antes de guardarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les espaces inutiles d’une commande sont retirées avant son enregistrement."

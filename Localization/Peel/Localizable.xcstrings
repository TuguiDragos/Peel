          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У репозиторії Git запрошення показує гілку, на якій ви перебуваєте, так, як її зчитує vcs_info, власна функція zsh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

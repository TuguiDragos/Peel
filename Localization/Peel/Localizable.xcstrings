        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS досі вважає цей пакет інстальованим, але з того, що він записав на диск, нічого не лишилося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS仍将此软件包视为已安装，但它放到磁盘上的内容已全部不在了。"

    "It is locked. In Finder, choose File > Get Info and deselect Locked, then try again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zamčená. Ve Finderu zvolte Soubor > Informace, zrušte zaškrtnutí políčka Zamčeno a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {

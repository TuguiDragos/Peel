        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel зберегла старий файл і працює далі з тим, що ще вдалося прочитати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

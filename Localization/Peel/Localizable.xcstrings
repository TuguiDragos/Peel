    "Type the start of a command, and the Up Arrow and Down Arrow go only through the commands that start that way." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napište začátek příkazu a šipky nahoru a dolů budou procházet jen příkazy, které takto začínají."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den Anfang eines Befehls ein, dann blätterst du mit Aufwärts- und Abwärtspfeil nur durch die Befehle, die so beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el principio de un comando, y las teclas Flecha arriba y Flecha abajo recorren solo los comandos que empiezan así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le début d’une commande, et les touches Flèche vers le haut et Flèche vers le bas ne parcourent que les commandes qui commencent ainsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita l’inizio di un comando, e i tasti Freccia su e Freccia giù scorrono solo i comandi che iniziano in quel modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドの先頭を入力すると、上矢印キーと下矢印キーで、入力した部分で始まるコマンドだけをたどれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령의 앞부분을 입력하면, 위쪽 화살표와 아래쪽 화살표로 그 내용으로 시작하는 명령만 오갈 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ het begin van een commando, en de pijl omhoog en de pijl omlaag doorlopen dan alleen de commando's die zo beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz początek polecenia, a klawisze ze strzałkami w górę i w dół będą przechodzić tylko przez polecenia, które tak się zaczynają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o começo de um comando, e as teclas Seta para Cima e Seta para Baixo percorrem só os comandos que começam assim."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastați începutul unei comenzi, iar tastele Săgeată sus și Săgeată jos parcurg doar comenzile care încep astfel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите начало команды, и клавиши со стрелками вверх и вниз будут перебирать только команды, которые так начинаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv början på ett kommando, så går uppåtpilen och nedåtpilen bara igenom de kommandon som börjar så."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir komutun başını yazın; Yukarı Ok ve Aşağı Ok yalnızca o şekilde başlayan komutlar arasında gezinir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть початок команди, і стрілки вгору та вниз перебиратимуть лише ті команди, що так починаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键入命令的开头部分后，上箭头键和下箭头键只会在以此开头的命令之间切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入指令的開頭後，向上鍵和向下鍵只會在以此開頭的指令之間切換。"
          }
        }
      }
    },

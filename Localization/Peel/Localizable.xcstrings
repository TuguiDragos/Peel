    "Every commit is signed with your SSH key, and GitHub shows it as Verified once you add the key there as a signing key." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý commit se podepíše vaším klíčem SSH a GitHub ho zobrazí jako Verified, jakmile tam klíč přidáte jako podpisový klíč."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Commit wird mit deinem SSH-Schlüssel signiert, und GitHub zeigt ihn als Verified an, sobald du den Schlüssel dort als Signaturschlüssel hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada commit se firma con tu clave SSH, y GitHub lo muestra como “Verified” en cuanto añades allí la clave como clave de firma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque commit est signé avec votre clé SSH, et GitHub l’affiche avec la mention Verified une fois que vous y avez ajouté la clé comme clé de signature."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni commit viene firmato con la tua chiave SSH, e GitHub lo mostra come Verified dopo che hai aggiunto la chiave su GitHub come chiave di firma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのコミットがSSH鍵で署名されます。その鍵をGitHubに署名鍵として追加すると、GitHubでコミットが“Verified”と表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 커밋이 SSH 키로 서명되며, 이 키를 GitHub에 서명 키로 추가하면 GitHub가 커밋을 ‘Verified’로 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke commit wordt ondertekend met je SSH-sleutel, en GitHub toont die als 'Verified' zodra je de sleutel daar als ondertekeningssleutel toevoegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy commit jest podpisywany Twoim kluczem SSH, a GitHub oznacza go jako Verified, gdy dodasz tam ten klucz jako klucz podpisu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada commit é assinado com a sua chave SSH, e o GitHub o mostra como Verified depois que você adiciona a chave lá como chave de assinatura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare commit este semnat cu cheia dvs. SSH, iar GitHub îl afișează ca Verified după ce adăugați acolo cheia ca cheie de semnare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый коммит подписывается Вашим SSH-ключом, и GitHub отмечает его меткой Verified, после того как Вы добавите туда этот ключ в качестве ключа подписи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje incheckning signeras med din SSH-nyckel, och GitHub visar den som Verified när du har lagt till nyckeln där som signeringsnyckel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her commit SSH anahtarınızla imzalanır ve anahtarı GitHub’a imzalama anahtarı olarak eklediğinizde GitHub onu Verified olarak gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен коміт підписується вашим ключем SSH, а GitHub позначає його як Verified, щойно ви додасте там цей ключ як ключ підпису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个提交都会使用你的SSH密钥签名；在GitHub上将该密钥添加为签名密钥后，GitHub会将提交显示为“Verified”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個提交都會以你的SSH密鑰簽署；在你將此密鑰加入GitHub作為簽署密鑰後，GitHub會將提交顯示為Verified。"
          }
        }
      }
    },

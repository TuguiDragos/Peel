          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat, dakikada bir değişmek yerine saniyeleri gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годинник показує секунди, а не змінюється раз на хвилину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时钟会显示秒数，而不是每分钟才变化一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時鐘會顯示秒數，而不是每分鐘才變動一次。"
          }
        }
      }
    },

        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acestea sunt datele pe care aplicația le păstrează pentru dvs. și pot include propriile dvs. lucrări. Peel nu le selectează niciodată pentru dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это то, что приложение хранит для Вас, и здесь может быть Ваша собственная работа. Peel никогда не выбирает это за Вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

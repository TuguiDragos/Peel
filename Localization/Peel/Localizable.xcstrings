    "The app’s privacy permissions are cleared first, and History can’t bring them back." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprávnění aplikace pro soukromé údaje se nejprve vymažou a Historie je nemůže vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenschutzberechtigungen der App werden zuerst zurückgesetzt, und über den Verlauf lassen sie sich nicht zurückholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se borran los permisos de privacidad de la app, e Historial no puede recuperarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations de confidentialité de l’app sont d’abord effacées, et l’Historique ne peut pas les rétablir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima vengono cancellate le autorizzazioni per la privacy dell’app, e la Cronologia non può ripristinarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのプライバシー権限が先に消去され、履歴から元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 개인정보 보호 권한이 먼저 지워지며, 기록에서 되살릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De privacytoestemmingen van de app worden eerst gewist, en Geschiedenis kan ze niet terugzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zostaną wyczyszczone uprawnienia prywatności aplikacji, a Historia nie może ich przywrócić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões de privacidade do app são limpas primeiro, e o Histórico não pode trazê-las de volta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai întâi se resetează permisiunile de intimitate ale aplicației, iar acestea nu pot fi readuse din Istoric."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала очищаются разрешения приложения на доступ, и История не сможет их вернуть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens integritetsbehörigheter rensas först, och Historik kan inte få tillbaka dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce uygulamanın gizlilik izinleri temizlenir ve Geçmiş bunları geri getiremez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу буде очищено дозволи приватності програми, і Історія не зможе їх повернути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App的隐私权限会先被清除，“历史记录”无法将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App的隱私權限會先被清除，而「歷史記錄」無法將其恢復。"
          }
        }
      }
    },
    "The available space includes %@ that macOS clears when something needs the room." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupné místo zahrnuje i %@, které macOS uvolní, jakmile bude místo potřeba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im verfügbaren Speicherplatz sind %@ enthalten, die macOS freigibt, sobald etwas den Platz braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio disponible incluye %@ que macOS libera cuando algo necesita sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace disponible comprend %@ que macOS libère lorsque de l’espace est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio disponibile include %@ che macOS libera quando qualcosa ne ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用可能な領域には、領域が必要になったときにmacOSが消去する%@が含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 공간에는 공간이 필요할 때 macOS가 비우는 %@의 공간이 포함되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De beschikbare ruimte omvat %@ die macOS opruimt zodra er ruimte nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępne miejsce obejmuje %@, które macOS zwalnia, gdy trzeba zrobić miejsce na coś innego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço disponível inclui %@ que o macOS libera quando algo precisa de lugar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spațiul disponibil include %@ pe care macOS îi eliberează când ceva are nevoie de loc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В доступное пространство входит %@ очищаемых данных, которые macOS удаляет, когда нужно место."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tillgängliga utrymmet omfattar %@ som macOS frigör när något behöver platsen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılabilir alana, macOS’in yer gerektiğinde temizlediği %@ dahildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До доступного місця входить %@ даних, які macOS очищає, коли щось потребує місця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间中包括%@，macOS会在需要空间时清除这部分内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空間中包含%@，macOS會在需要空間時將其清除。"
          }
        }
      }
    },
    "The clock shows seconds instead of changing once a minute." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodiny zobrazují sekundy, místo aby se měnily jednou za minutu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhr zeigt Sekunden an, statt sich nur einmal pro Minute zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj muestra los segundos en vez de cambiar una vez por minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’horloge affiche les secondes au lieu de changer une fois par minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’orologio mostra i secondi invece di cambiare una volta al minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時計が、1分ごとではなく秒単位で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계가 1분에 한 번 바뀌는 대신 초까지 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De klok toont seconden in plaats van één keer per minuut te verspringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegar pokazuje sekundy, zamiast zmieniać się raz na minutę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relógio mostra os segundos em vez de mudar uma vez por minuto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",

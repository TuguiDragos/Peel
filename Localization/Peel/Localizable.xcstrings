    },
    "Apps you keep in the Dock are remembered, and come back when you turn this off." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace, které máte v Docku, zůstanou zapamatované a po vypnutí této volby se vrátí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps, die du im Dock behältst, bleiben gespeichert und kehren zurück, wenn du dies deaktivierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps que tienes en el Dock se recuerdan y vuelven cuando desactivas esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps que vous gardez dans le Dock sont mémorisées, et reviennent lorsque vous désactivez ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app che tieni nel Dock vengono ricordate e tornano quando disattivi questa opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockに置いているアプリは記憶されていて、これをオフにすると元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock에 유지해 둔 앱은 기억되며, 이 설정을 끄면 다시 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps die je in het Dock bewaart, worden onthouden en komen terug als je dit uitschakelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje trzymane w Docku są zapamiętywane i wracają po wyłączeniu tej opcji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps que você mantém no Dock são lembrados e voltam quando você desativa isto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicațiile pe care le păstrați în Dock sunt reținute și revin când dezactivați această opțiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения, закрепленные в Dock, запоминаются и вернутся, когда Вы выключите этот параметр."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De appar som du har i Dock sparas och kommer tillbaka när du stänger av det här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock’ta tuttuğunuz uygulamalar hatırlanır ve bunu kapattığınızda geri gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програми, які ви тримаєте в Dock, запамʼятовуються й повертаються, коли ви це вимкнете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你保留在程序坞中的App会被记住，关闭此项后它们会重新出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你保留在Dock中的App會被記住，關閉此設定後就會回來。"
          }
        }
      }
    },

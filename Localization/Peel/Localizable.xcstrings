    "Finder stops asking whether you’re sure when you change a file’s extension." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder se přestane ptát, jestli jste si jistí, když měníte příponu souboru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Finder fragt nicht mehr nach, ob du dir sicher bist, wenn du das Suffix einer Datei änderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Finder deja de pedirte confirmación al cambiar la extensión de un archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Finder cesse de vous demander confirmation lorsque vous modifiez l’extension d’un fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Finder smette di chiederti conferma quando cambi l’estensione di un file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの拡張子を変更するときに、Finderが確認しなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일의 확장자를 변경할 때 Finder가 변경할지 다시 묻지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder vraagt niet meer of je het zeker weet als je de extensie van een bestand wijzigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder przestaje pytać, czy na pewno chcesz zmienić rozszerzenie pliku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Finder para de perguntar se você tem certeza quando você altera a extensão de um arquivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nu vă mai întreabă dacă sunteți sigur când schimbați extensia unui fișier."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder перестает переспрашивать, уверены ли Вы, когда Вы меняете расширение файла."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder slutar fråga om du är säker när du ändrar filnamnstillägget för en fil."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dosyanın uzantısını değiştirdiğinizde Finder emin olup olmadığınızı sormayı bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder перестає перепитувати, чи ви впевнені, коли ви змінюєте розширення файлу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改文件的扩展名时，“访达”不再询问你是否确定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改檔案的副檔名時，Finder不再詢問你是否確定。"
          }
        }
      }
    },
    "Finder stops creating .DS_Store files on network volumes, so it no longer remembers how you arranged folders there." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder přestane na síťových svazcích vytvářet soubory .DS_Store, takže si už nebude pamatovat, jak jste tam uspořádali složky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Finder erstellt auf Netzwerkvolumes keine .DS_Store-Dateien mehr und merkt sich daher nicht mehr, wie du Ordner dort angeordnet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Finder deja de crear archivos .DS_Store en los volúmenes de red, así que ya no recuerda cómo has organizado allí las carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Finder cesse de créer des fichiers .DS_Store sur les volumes réseau : il ne mémorise donc plus la disposition des dossiers qui s’y trouvent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Finder smette di creare file .DS_Store sui volumi di rete, quindi non ricorda più come hai organizzato le cartelle lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderがネットワークボリュームに.DS_Storeファイルを作成しなくなるため、そこでのフォルダの並べ方は記憶されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder가 네트워크 볼륨에 .DS_Store 파일을 만들지 않으므로, 그곳의 폴더를 어떻게 정렬했는지 더 이상 기억하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder maakt geen .DS_Store-bestanden meer aan op netwerkvolumes, dus Finder onthoudt daar niet meer hoe je mappen hebt ingedeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder przestaje tworzyć pliki .DS_Store na woluminach sieciowych, więc nie pamięta już, jak rozmieszczono tam foldery."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Finder para de criar arquivos .DS_Store em volumes de rede, então não lembra mais como você organizou as pastas lá."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nu mai creează fișiere .DS_Store pe volumele de rețea, așa că nu mai reține cum ați aranjat dosarele acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder перестает создавать файлы .DS_Store на сетевых томах, поэтому больше не запоминает, как Вы упорядочили там папки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder slutar skapa .DS_Store-filer på nätverksvolymer, så Finder kommer inte längre ihåg hur du ordnade mappar där."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder ağ disk bölümlerinde .DS_Store dosyaları oluşturmayı bırakır, bu yüzden oradaki klasörleri nasıl düzenlediğinizi artık hatırlamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder перестає створювати файли .DS_Store на мережевих томах, тож більше не памʼятає, як ви впорядкували там папки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“访达”不再在网络宗卷上创建“.DS_Store”文件，因此也不会再记住你在那里对文件夹的排列方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder不再於網路卷宗上建立「.DS_Store」檔案，因此不會再記住你在那裡如何排列檔案夾。"
          }
        }
      }
    },
    "Finder stops hiding the part after the dot." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder přestane skrývat část názvu za tečkou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Finder blendet den Teil nach dem Punkt nicht mehr aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Finder deja de ocultar la parte que va después del punto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Finder cesse de masquer la partie située après le point."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Finder smette di nascondere la parte dopo il punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderが、ドット以降の部分を隠さなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder가 마침표 뒤의 부분을 더 이상 가리지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder verbergt het deel na de punt niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder przestaje ukrywać część po kropce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Finder para de ocultar a parte depois do ponto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder nu mai ascunde partea de după punct."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder перестает скрывать часть имени после точки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder slutar gömma delen efter punkten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder noktadan sonraki kısmı gizlemeyi bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder перестає ховати частину назви після крапки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“访达”不再隐藏点后面的部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder不再隱藏句點後面的部分。"
          }
        }
      }
    },
    "Firmware for restoring Apple devices, such as an iPhone, an iPad, or a Mac. It is downloaded again when a device needs it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware pro obnovu zařízení Apple, jako je iPhone, iPad nebo Mac. Když ho zařízení potřebuje, stáhne se znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware zum Wiederherstellen von Apple-Geräten wie iPhone, iPad oder Mac. Sie wird erneut geladen, wenn ein Gerät sie benötigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware para restaurar dispositivos Apple, como un iPhone, un iPad o un Mac. Se vuelve a descargar cuando un dispositivo lo necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programme interne servant à restaurer des appareils Apple, comme un iPhone, un iPad ou un Mac. Il est téléchargé à nouveau lorsqu’un appareil en a besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware per ripristinare i dispositivi Apple, come iPhone, iPad o Mac. Viene scaricato di nuovo quando un dispositivo ne ha bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone、iPad、MacなどのAppleデバイスを復元するためのファームウェアです。デバイスが必要とするときに再びダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, iPad 또는 Mac 같은 Apple 기기를 복원하기 위한 펌웨어입니다. 기기에 필요할 때 다시 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware om Apple-apparaten te herstellen, zoals een iPhone, iPad of Mac. Die wordt opnieuw gedownload wanneer een apparaat die nodig heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprogramowanie sprzętowe do odtwarzania urządzeń Apple, takich jak iPhone, iPad czy Mac. Jest pobierane ponownie, gdy urządzenie go potrzebuje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware para restaurar dispositivos Apple, como um iPhone, um iPad ou um Mac. Ele é baixado de novo quando um dispositivo precisa dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmware pentru restaurarea dispozitivelor Apple, cum ar fi un iPhone, un iPad sau un Mac. Se descarcă din nou când un dispozitiv are nevoie de el."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прошивки для восстановления устройств Apple, например iPhone, iPad или Mac. Прошивка загружается снова, когда она нужна устройству."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast programvara för att återställa Apple-enheter, till exempel en iPhone, en iPad eller en Mac. Den hämtas igen när en enhet behöver den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, iPad veya Mac gibi Apple aygıtlarını geri yüklemek için firmware. Bir aygıt ihtiyaç duyduğunda yeniden indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прошивки для відновлення пристроїв Apple, як-от iPhone, iPad чи Mac. Їх буде викачано знову, коли пристрій цього потребуватиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于恢复Apple设备（例如iPhone、iPad或Mac）的固件。设备需要时会重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於回復Apple裝置（例如iPhone、iPad或Mac）的韌體。裝置需要時會重新下載。"
          }
        }
      }
    },

        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS починає їхні назви словами «Знімок екрана». Введіть іншу назву, щоб використовувати її натомість."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

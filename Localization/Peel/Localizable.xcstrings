    "Diffs first match the lines that appear rarely, so changes line up around them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffy nejprve párují řádky, které se vyskytují zřídka, takže se změny zarovnají kolem nich."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffs ordnen zuerst die selten vorkommenden Zeilen einander zu, sodass sich Änderungen an ihnen ausrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los diffs emparejan primero las líneas que aparecen pocas veces, para que los cambios se alineen en torno a ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les diffs font d’abord correspondre les lignes qui apparaissent rarement, de sorte que les modifications s’alignent autour d’elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I diff abbinano per prime le righe che compaiono di rado, così le modifiche si allineano attorno a quelle righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "差分の作成時に、出現頻度の低い行を先に対応付けるため、変更箇所がそれらの行を基準に揃います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "diff가 드물게 나타나는 줄을 먼저 맞추므로, 변경 사항이 그 줄을 기준으로 정렬됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffs koppelen eerst de regels die zelden voorkomen, zodat wijzigingen daaromheen op hun plek vallen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wyznaczaniu różnic najpierw dopasowywane są wiersze, które występują rzadko, więc zmiany układają się wokół nich."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os diffs emparelham primeiro as linhas que aparecem raramente, e assim as alterações se alinham em torno delas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diff‑urile potrivesc mai întâi liniile care apar rar, așa că modificările se aliniază în jurul lor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При сравнении сначала сопоставляются строки, которые встречаются редко, поэтому изменения выстраиваются вокруг них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffar matchar först de rader som förekommer sällan, så att ändringarna radas upp kring dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diff’ler önce seyrek görülen satırları eşleştirir; böylece değişiklikler bu satırların çevresinde hizalanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час порівняння спершу зіставляються рядки, що трапляються рідко, тож зміни вирівнюються навколо них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较差异时会先匹配很少出现的行，使更改围绕这些行对齐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比對差異時會先配對很少出現的行，讓變更圍繞著這些行對齊。"
          }
        }
      }
    },

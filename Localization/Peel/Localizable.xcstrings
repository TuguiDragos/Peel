    "Not selected: Mail keeps a copy here of each attachment you open, and one you edited may exist nowhere else." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevybráno: aplikace Mail zde uchovává kopii každé přílohy, kterou otevřete, a kopie, kterou jste upravili, nemusí existovat nikde jinde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht ausgewählt: Mail bewahrt hier eine Kopie jedes Anhangs auf, den du öffnest, und eine bearbeitete Kopie gibt es möglicherweise nirgendwo sonst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin seleccionar: Mail guarda aquí una copia de cada archivo adjunto que abres, y una que hayas editado puede no existir en ningún otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sélectionné : Mail conserve ici une copie de chaque pièce jointe que vous ouvrez, et une copie que vous avez modifiée n’existe peut-être nulle part ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non selezionato: Mail conserva qui una copia di ogni allegato che apri, e una copia che hai modificato potrebbe non esistere altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未選択: メールは開いた添付ファイルのコピーをここに保存しており、編集したコピーはほかのどこにも存在しない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택되지 않음: Mail은 사용자가 여는 각 첨부 파일의 복사본을 여기에 보관하며, 편집한 복사본은 다른 곳에 없을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet geselecteerd: Mail bewaart hier een kopie van elke bijlage die je opent, en een kopie die je hebt bewerkt, bestaat misschien nergens anders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zaznaczono: Poczta przechowuje tu kopię każdego otwieranego przez Ciebie załącznika, a edytowana przez Ciebie kopia może nie istnieć nigdzie indziej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não selecionado: o Mail mantém aqui uma cópia de cada anexo que você abre, e uma cópia que você editou pode não existir em nenhum outro lugar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neselectat: Mail păstrează aici o copie a fiecărui fișier atașat pe care îl deschideți, iar o copie pe care ați editat‑o poate să nu existe în altă parte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не выбрано: Почта хранит здесь копию каждого вложения, которое Вы открываете, а отредактированная Вами копия, возможно, есть только здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte markerad: Mail sparar här en kopia av varje bilaga du öppnar, och en bilaga som du har redigerat finns kanske inte någon annanstans."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilmedi: Mail, açtığınız her ilişkinin bir kopyasını burada tutar; düzenlediğiniz bir kopya başka hiçbir yerde bulunmayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вибрано: Пошта зберігає тут копію кожного вкладення, яке ви відкриваєте, а відредаговане вами вкладення може більше ніде не зберігатися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未选择：“邮件”会在此处为你打开的每个附件保留一个副本，而你编辑过的副本可能在其他任何地方都不存在。"
          }

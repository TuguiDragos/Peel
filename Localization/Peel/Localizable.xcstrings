    "Peel found no file here that is safely in iCloud and big enough to be worth freeing." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel tu nenašel žádný soubor, který by byl bezpečně na iCloudu a zároveň tak velký, aby stál za uvolnění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel hat hier keine Datei gefunden, die sicher in iCloud liegt und so groß ist, dass sich das Freigeben lohnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel no ha encontrado aquí ningún archivo que esté a salvo en iCloud y sea lo bastante grande como para que valga la pena liberarlo."

          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój plik %@ ustawia własny znak zachęty po wierszu Peel, więc zsh wyświetla właśnie ten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

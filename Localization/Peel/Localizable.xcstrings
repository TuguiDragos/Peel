        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando foi visto pela primeira vez, estava assinado por %@, e agora é assinado por %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când a fost văzută prima dată, era semnată de %@, iar acum este semnată de %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда Peel впервые его увидел, оно было подписано разработчиком %@, а теперь подписано разработчиком %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта папка находится в iCloud Drive или другой облачной папке, и Peel оставляет ее приложению, которое ее синхронизирует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ligger i iCloud Drive eller i en annan molnmapp, som Peel lämnar åt appen som synkroniserar den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive’da veya başka bir bulut klasöründe; Peel bunu, onu eşzamanlayan uygulamaya bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка лежить в iCloud Drive або в іншій хмарній папці, а такі папки Peel залишає програмі, яка їх синхронізує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

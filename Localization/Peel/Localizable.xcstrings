    "The link points at Peel where it is now, %@, so it breaks if Peel moves. Apps live in the Applications folder." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz vede na Peel v jeho současném umístění, %@, takže přestane fungovat, když se Peel přesune. Aplikace patří do složky Aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link verweist auf Peel an seinem jetzigen Ort, %@, und funktioniert daher nicht mehr, wenn Peel verschoben wird. Apps gehören in den Ordner „Programme“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace apunta a Peel donde está ahora, %@, así que se rompe si Peel se mueve. Las apps van en la carpeta Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien pointe vers Peel à son emplacement actuel, %@ : il ne fonctionnera donc plus si Peel est déplacé. La place des apps est dans le dossier Applications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link punta a Peel nella sua posizione attuale, %@, quindi smette di funzionare se Peel viene spostato. Le app stanno nella cartella Applicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクは現在のPeelの場所（%@）を指しているため、Peelを移動するとリンクが切れます。アプリは“アプリケーション”フォルダに置くものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크가 현재 위치(%@)의 Peel을 가리키므로 Peel을 옮기면 링크가 작동하지 않습니다. 앱의 자리는 응용 프로그램 폴더입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De link verwijst naar Peel op de huidige plek, %@, dus de link werkt niet meer als Peel wordt verplaatst. Apps horen in de map 'Apps'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowiązanie wskazuje na Peel w obecnym miejscu, %@, więc przestanie działać, jeśli Peel zostanie przeniesiony. Miejsce aplikacji jest w folderze Aplikacje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link aponta para o Peel onde ele está agora, %@, então para de funcionar se o Peel mudar de lugar. Os apps ficam na pasta Aplicativos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkul indică spre Peel acolo unde se află acum, %@, așa că nu va mai funcționa dacă Peel este mutat. Locul aplicațiilor este în dosarul Aplicații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка указывает на Peel там, где он находится сейчас (%@), поэтому она перестанет работать, если Peel переместить. Приложениям место в папке «Программы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Länken pekar på Peel där appen ligger nu, %@, så den slutar fungera om Peel flyttas. Appar hör hemma i mappen Appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı, Peel’i şu an bulunduğu yerde (%@) gösteriyor, bu yüzden Peel taşınırsa bozulur. Uygulamaların yeri Uygulamalar klasörüdür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посилання вказує на Peel там, де вона зараз (%@), тож перестане працювати, якщо Peel переміститься. Місце програм у папці «Програми»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该链接指向Peel当前所在的位置%@，因此Peel一旦移动，链接就会失效。App应放在“应用程序”文件夹中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連結指向Peel目前的位置（%@），因此如果Peel移動，連結就會失效。App應放在「應用程式」檔案夾中。"
          }
        }
      }
    },

    "Apps that use it may stop working." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace, které ho používají, mohou přestat fungovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps, die es verwenden, funktionieren möglicherweise nicht mehr."
          }
        },
        "es" : {

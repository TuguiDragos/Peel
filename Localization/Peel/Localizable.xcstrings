    "What History forgets, it can’t put back afterwards." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co Historie zapomene, to už pak nemůže vrátit zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was der Verlauf vergisst, kann er danach nicht mehr zurücklegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que Historial olvida, no puede restaurarlo después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que l’Historique oublie, il ne peut pas le remettre en place par la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che la Cronologia dimentica, non può più ripristinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴から削除した項目は、あとから戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에서 지운 항목은 나중에 되돌려 놓을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat Geschiedenis vergeet, kan Geschiedenis daarna niet meer terugzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego, co Historia zapomni, nie może potem przywrócić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o Histórico esquece, ele não pode colocar de volta depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce uitați nu mai puteți pune înapoi din Istoric."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что История забудет, она потом не сможет восстановить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som Historik glömmer kan den inte lägga tillbaka efteråt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş, unuttuklarını sonradan yerine koyamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, що Історія забуде, вона вже не зможе повернути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除记录后，“历史记录”就无法再将相应的项目放回原处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「歷史記錄」移除記錄後，就無法再還原這些項目。"
          }
        }
      }
    },

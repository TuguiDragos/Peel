    "A Finder window’s title says the whole path rather than the folder’s name." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název okna Finderu ukazuje celou cestu, a ne jen název složky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Titel eines Finder-Fensters zeigt den ganzen Pfad statt des Ordnernamens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El título de una ventana del Finder muestra la ruta completa en vez del nombre de la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titre d’une fenêtre du Finder indique le chemin complet plutôt que le nom du dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il titolo di una finestra del Finder mostra l’intero percorso anziché il nome della cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderウインドウのタイトルに、フォルダの名前ではなくパス全体が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder 윈도우의 제목에 폴더 이름 대신 전체 경로가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De titel van een Finder-venster toont het hele pad in plaats van de naam van de map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tytuł okna Findera pokazuje całą ścieżkę zamiast nazwy folderu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O título de uma janela do Finder mostra o caminho inteiro em vez do nome da pasta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titlul unei ferestre Finder arată calea completă în locul numelui dosarului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В заголовке окна Finder показывается полный путь, а не имя папки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titeln i ett Finder-fönster visar hela sökvägen i stället för mappens namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Finder penceresinin başlığında klasörün adı yerine yolun tamamı yazar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У заголовку вікна Finder відображається повний шлях, а не назва папки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“访达”窗口的标题会显示完整路径，而不是文件夹名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder視窗的標題會顯示完整路徑，而不是檔案夾名稱。"
          }
        }
      }
    },
    "A Save dialog opens with your folders showing, instead of only a name and where to save it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dialogové okno Uložit při otevření zobrazí vaše složky, a ne jen název a místo uložení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dialog „Sichern“ öffnet sich mit deinen Ordnern statt nur mit Namen und Speicherort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cuadro de diálogo Guardar se abre mostrando tus carpetas, en vez de solo el nombre y dónde guardarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zone de dialogue Enregistrer s’ouvre en affichant vos dossiers, au lieu de ne demander qu’un nom et un emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra di dialogo Salva si apre mostrando le tue cartelle, invece che solo il nome del file e dove salvarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“保存”ダイアログが、名前と保存場所だけでなく、フォルダも表示した状態で開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 대화상자가 이름과 저장 위치만 표시되는 대신 폴더까지 보이는 상태로 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bewaarvenster toont meteen je mappen, in plaats van alleen een naam en een locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno dialogowe Zachowaj otwiera się, pokazując Twoje foldery, a nie tylko nazwę i miejsce zachowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caixa de diálogo Salvar abre mostrando as suas pastas, em vez de só o nome e o local onde salvar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dialogul Salvați se deschide cu dosarele dvs. afișate, în loc să arate doar un nume și unde să‑l salvați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диалоговое окно сохранения сразу показывает Ваши папки, а не только имя и место сохранения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dialogrutan Spara öppnas med dina mappar synliga, i stället för att bara visa ett namn och var dokumentet ska sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydet sorgu kutusu, yalnızca bir ad ve nereye kaydedileceğini sormak yerine klasörlerinizi göstererek açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діалогове вікно «Зберегти» відкривається й показує ваші папки, а не лише назву та місце збереження."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“保存”对话框打开时会显示你的文件夹，而不是只显示名称和保存位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В iCloud Drive більше, ніж Peel може переглянути за один раз, а в прочитаній частині немає нічого настільки великого, щоб його варто було звільняти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

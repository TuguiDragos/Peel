        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Homebrew есть более новые версии этих пакетов. Закрепленный пакет удерживается намеренно, поэтому он показан в списке, но остается как есть."
          }
        },
        "sv" : {

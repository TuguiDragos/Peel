          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest na iCloud Drive lub w innym folderze w chmurze, który Peel zostawia aplikacji, która go synchronizuje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

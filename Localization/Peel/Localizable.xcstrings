        }
      }
    },
    "Homebrew no longer offers it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ho už nenabízí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew bietet dieses Tool nicht mehr an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ya no lo ofrece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ne le propose plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew non lo offre più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewは提供を終了しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew는 이 도구를 더 이상 제공하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew biedt het niet meer aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew już go nie udostępnia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Homebrew não oferece mais esta ferramenta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew nu îl mai oferă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew больше не предлагает его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew erbjuder det inte längre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew artık onu sunmuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew більше не пропонує цей інструмент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew已不再提供它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew已不再提供此工具。"
          }
        }
      }
    },
    "Homebrew no longer offers it: it can’t be installed again and gets no more upgrades. What is installed stays until you uninstall it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ho už nenabízí: nelze ho znovu nainstalovat a nedostává žádné další upgrady. Co je nainstalováno, zůstane, dokud to neodinstalujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew bietet das Paket nicht mehr an: Es kann nicht erneut installiert werden und erhält keine Upgrades mehr. Was installiert ist, bleibt, bis du es deinstallierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ya no lo ofrece: no se puede volver a instalar y ya no recibe actualizaciones. Lo que está instalado se queda hasta que lo desinstales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ne le propose plus : il ne peut plus être installé et ne reçoit plus de mises à niveau. Ce qui est installé reste en place jusqu’à ce que vous le désinstalliez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew non lo offre più: non può più essere installato e non riceve più aggiornamenti. Ciò che è installato resta finché non lo disinstalli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewは提供を終了しています。再インストールはできず、今後はアップグレードもされません。インストール済みのものは、アンインストールするまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew는 이 패키지를 더 이상 제공하지 않습니다. 다시 설치할 수 없으며 더 이상 업그레이드되지 않습니다. 이미 설치된 항목은 제거할 때까지 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew biedt het niet meer aan: het kan niet opnieuw worden geïnstalleerd en krijgt geen upgrades meer. Wat al is geïnstalleerd, blijft staan totdat je het deïnstalleert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew już go nie udostępnia: nie można go ponownie zainstalować ani uaktualnić. To, co jest zainstalowane, zostaje, dopóki tego nie odinstalujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Homebrew não o oferece mais: ele não pode ser instalado de novo e não recebe mais upgrades. O que já está instalado permanece até você desinstalá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew nu îl mai oferă: nu poate fi instalat din nou și nu mai primește upgrade‑uri. Ce este instalat rămâne până când îl dezinstalați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew больше не предлагает его: его нельзя установить снова, и он больше не получает обновлений. Уже установленный пакет остается, пока Вы его не удалите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew erbjuder det inte längre: det kan inte installeras igen och får inga fler uppgraderingar. Det som är installerat finns kvar tills du avinstallerar det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew artık onu sunmuyor: yeniden yüklenemez ve başka yükseltme almaz. Yüklü olan, siz yüklemesini kaldırana kadar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew більше не пропонує цей пакет: його не можна інсталювати знову, і оновлень для нього більше не буде. Те, що вже інстальовано, лишається, доки ви його не деінсталюєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew已不再提供它：它无法再次安装，也不会再获得升级。已安装的内容会一直保留，直到你将其卸载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew已不再提供此套件：它無法再次安裝，也不會再收到升級。已安裝的版本仍會保留，直到你將它解除安裝。"
          }
        }
      }
    },
    "Homebrew ran into a problem. What it said is on the app’s page in Peel, if that page is still open." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew narazil na problém. Co hlásil, najdete na stránce aplikace v Peelu, pokud je tato stránka stále otevřená."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ist auf ein Problem gestoßen. Was es gemeldet hat, steht auf der Seite der App in Peel, falls diese Seite noch geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew ha tenido un problema. Lo que ha dicho está en la página de la app en Peel, si esa página sigue abierta."
          }
        },
        "fr" : {

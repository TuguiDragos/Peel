    "Anyone on this Mac can change it, so Peel won’t run it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Může ho změnit kdokoli v tomto Macu, a proto ho Peel nespustí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Benutzeraccount auf diesem Mac kann diese Datei ändern, daher führt Peel sie nicht aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera en este Mac puede cambiarlo, así que Peel no lo ejecutará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’importe qui sur ce Mac peut le modifier, donc Peel ne l’exécutera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque su questo Mac può modificarlo, quindi Peel non lo eseguirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacのどのユーザでも変更できるため、Peelはこのファイルを実行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 누구나 변경할 수 있는 파일이므로 Peel은 이 파일을 실행하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen op deze Mac kan het wijzigen, dus Peel voert het niet uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy na tym Macu może go zmienić, więc Peel go nie uruchomi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa neste Mac pode alterá-lo, então o Peel não o executará."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oricine de pe acest Mac îl poate modifica, așa că Peel nu îl va rula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой пользователь этого Mac может его изменить, поэтому Peel не будет его запускать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla på den här datorn kan ändra den, så Peel kör den inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’teki herkes onu değiştirebilir, bu yüzden Peel onu çalıştırmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто на цьому Mac може його змінити, тому Peel не запускатиме його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台Mac上的任何人都可以更改它，因此Peel不会运行它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部Mac上的任何人都能變更它，因此Peel不會執行它。"
          }
        }
      }
    },
    "Anything after # on the command line is a comment, as in a script, so a pasted command with comments runs." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše, co na příkazovém řádku následuje za znakem #, je komentář, stejně jako ve skriptu, takže se vložený příkaz s komentáři spustí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles nach # in der Befehlszeile ist ein Kommentar, wie in einem Skript, sodass ein eingesetzter Befehl mit Kommentaren ausgeführt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que va después de # en la línea de comandos es un comentario, como en un script, así que un comando pegado con comentarios se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui suit # sur la ligne de commande est un commentaire, comme dans un script : une commande collée qui contient des commentaires s’exécute donc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che segue # sulla riga di comando è un commento, come in uno script, quindi anche un comando incollato che contiene commenti viene eseguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトと同じように、コマンドラインの#以降はコメントになるため、コメント付きのコマンドをペーストしても実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트에서처럼 명령어 라인에서 # 뒤에 오는 내용은 모두 주석이 되므로, 주석이 포함된 명령을 붙여 넣어도 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles na # op de commandoregel is commentaar, zoals in een script, zodat een geplakt commando met commentaar wordt uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko po znaku # w wierszu polecenia jest komentarzem, tak jak w skrypcie, więc wklejone polecenie z komentarzami zadziała."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que vem depois de # na linha de comando é um comentário, como em um script, então um comando colado com comentários é executado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot ce urmează după # pe linia de comandă este un comentariu, ca într‑un script, așa că o comandă lipită care conține comentarii rulează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все, что идет после # в командной строке, считается комментарием, как в скрипте, поэтому вставленная команда с комментариями выполняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt efter # på kommandoraden är en kommentar, som i ett skript, så att ett inklistrat kommando med kommentarer går att köra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut satırında # işaretinden sonra gelen her şey, bir betikte olduğu gibi yorum sayılır; böylece yorum içeren yapıştırılmış bir komut çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, що стоїть після # у командному рядку, вважається коментарем, як у скрипті, тож вставлена команда з коментарями виконується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令行中#之后的所有内容都是注释，与脚本中一样，因此粘贴的带注释的命令也能运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令列上#之後的內容都是註解，就像在指令碼中一樣，因此貼上含有註解的指令也能執行。"
          }
        }
      }
    },

          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleinere bestanden dan PNG, met iets minder detail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniejsze pliki niż PNG, z nieco mniejszą szczegółowością."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos menores que PNG, com um pouco menos de detalhe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișiere mai mici decât PNG, cu ceva mai puține detalii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы меньше, чем в PNG, но с чуть меньшей детализацией."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre filer än PNG, med något färre detaljer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG’den daha küçük dosyalar, biraz daha az ayrıntıyla."
          }
        },
        "uk" : {
          "stringUnit" : {

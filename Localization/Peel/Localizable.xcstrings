          }
        }
      }
    },
    "Snapshots another app made, such as a backup app, are that app’s to remove, not Peel’s." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímky, které vytvořila jiná aplikace, například zálohovací, má odstraňovat tato aplikace, ne Peel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshots, die eine andere App erstellt hat, etwa eine Backup-App, entfernt diese App, nicht Peel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las instantáneas que creó otra app, como una app de copias de seguridad, las tiene que eliminar esa app, no Peel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les instantanés créés par une autre app, comme une app de sauvegarde, sont à supprimer par cette app, pas par Peel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere le istantanee create da un’altra app, come un’app di backup, spetta a quell’app, non a Peel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップアプリなど、ほかのアプリが作成したスナップショットは、Peelではなくそのアプリが削除するものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업 앱처럼 다른 앱이 만든 스냅샷은 Peel이 아니라 그 앱이 제거해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momentopnamen die een andere app heeft gemaakt, zoals een back-upapp, moet die app verwijderen, niet Peel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migawki utworzone przez inną aplikację, na przykład do backupów, może usunąć tylko ta aplikacja, a nie Peel."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover as capturas criadas por outro app, como um app de backup, cabe a esse app, não ao Peel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantaneele create de o altă aplicație, cum ar fi o aplicație de backup, trebuie eliminate de aplicația respectivă, nu de Peel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимки, созданные другим приложением, например приложением для резервного копирования, удаляет это приложение, а не Peel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ögonblicksbilder som en annan app har skapat, till exempel en app för säkerhetskopiering, är den appens sak att ta bort, inte Peels."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekleme uygulaması gibi başka bir uygulamanın aldığı anlık görüntüleri kaldırmak Peel’e değil, o uygulamaya düşer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімки, створені іншою програмою, як-от програмою для резервного копіювання, має вилучати та програма, а не Peel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他App（例如备份App）创建的快照应由该App移除，而不是由Peel移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他App（例如備份App）建立的快照應由該App移除，而不是由Peel移除。"
          }
        }
      }
    },
    "Software installed with an installer package, other than Apple’s, will appear here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",

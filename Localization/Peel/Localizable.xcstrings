        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulama bunu kendi Kitaplık klasöründe tutuyor ve şu anda kullanıyor olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма зберігає цей файл у папці «Бібліотека» і, можливо, саме зараз його використовує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

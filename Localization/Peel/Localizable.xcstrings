    "It isn’t a folder Peel can reach. A disk that isn’t connected looks like this too." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není to složka, ke které má Peel přístup. Stejně vypadá i disk, který není připojený."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist kein Ordner, den Peel erreichen kann. Ein Volume, das nicht verbunden ist, sieht ebenfalls so aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una carpeta a la que Peel pueda acceder. Un disco que no está conectado también se ve así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

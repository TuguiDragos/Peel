    "History keeps what it can’t see until Peel can look again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historie si ponechá, co nevidí, dokud se Peel nebude moci znovu podívat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf behält, was er nicht sehen kann, bis Peel wieder nachsehen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historial conserva lo que no puede ver hasta que Peel pueda volver a mirar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Historique conserve ce qu’il ne peut pas voir, jusqu’à ce que Peel puisse y regarder à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Cronologia conserva ciò che non vede finché Peel non potrà guardare di nuovo nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認できない項目は、Peelが再び調べられるようになるまで履歴に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼 수 없는 항목은 Peel이 다시 살펴볼 수 있을 때까지 기록에 그대로 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschiedenis bewaart wat Peel niet kan zien, totdat Peel weer kan kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia zachowuje to, czego nie widzi, dopóki Peel nie będzie mógł znów tam zajrzeć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Histórico mantém o que não consegue ver até que o Peel possa examinar o Lixo de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istoricul păstrează ce nu poate vedea până când Peel poate căuta din nou în Coș."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История сохраняет то, чего не видит, пока Peel снова не сможет туда заглянуть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historik behåller det som den inte kan se tills Peel kan titta igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş, göremediklerini Peel yeniden bakabilene kadar tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія зберігає те, чого не бачить, доки Peel знову не зможе туди зазирнути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Peel能够再次查看废纸篓之前，“历史记录”会保留它看不到的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「歷史記錄」會保留它看不到的項目，直到Peel能再次查看。"
          }
        }
      }
    },
    "Hold Control and Command and drag, instead of aiming for the title bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte Control a Command a táhněte, aniž byste museli mířit na záhlaví okna."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Control und Command gedrückt und ziehe, statt auf die Titelleiste zu zielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas las teclas Control y Comando y arrastra, en vez de apuntar a la barra de título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez les touches Contrôle et Commande enfoncées et faites glisser, au lieu de viser la barre de titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuti Ctrl e Comando e trascina, invece di mirare alla barra del titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルバーを狙わなくても、ControlキーとCommandキーを押したままドラッグできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목 막대를 겨냥할 필요 없이 Control 키와 Command 키를 누른 채 드래그합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd Control en Command ingedrukt en sleep, in plaats van op de titelbalk te mikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj klawisze Control i Command, a następnie przeciągnij, zamiast celować w pasek tytułu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionadas as teclas Control e Command e arraste, em vez de mirar na barra de título."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Țineți apăsate tastele Control și Comandă și trageți, în loc să țintiți bara de titlu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте Control и Command и перетаскивайте, вместо того чтобы целиться в строку заголовка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned kontroll- och kommandotangenterna och dra, i stället för att sikta på namnlisten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlık çubuğunu hedeflemek yerine Kontrol ve Komut tuşlarını basılı tutup sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуючи клавіші Control і Command, перетягуйте вікно, а не цільтеся в смугу заголовка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住Control键和Command键并拖移，无需对准标题栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住Control + Command鍵並拖移，不必對準標題列。"
          }
        }
      }
    },
    "Holding a key repeats it" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržená klávesa se opakuje"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine gedrückt gehaltene Taste wird wiederholt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las teclas se repiten al mantenerlas pulsadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une touche maintenue se répète"
          }
        },
        "it" : {
          "stringUnit" : {

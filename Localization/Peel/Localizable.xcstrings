    "Peel couldn’t list the snapshots kept on this disk, which may hold some of its space." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel nemohl vypsat snímky uložené na tomto disku, které mohou zabírat část jeho místa."
          }
        },
        "de" : {
          "stringUnit" : {

        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is wat de app voor je bewaart, en daar kan je eigen werk bij zitten. Peel selecteert dit nooit voor je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To dane, które aplikacja przechowuje dla Ciebie i które mogą obejmować Twoją własną pracę. Peel nigdy nie zaznacza ich za Ciebie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é o que o app guarda para você, o que pode incluir o seu próprio trabalho. O Peel nunca seleciona isto por você."
          }

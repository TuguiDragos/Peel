    "Nobody has decided about it, so macOS chooses." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikdo o něm nerozhodl, takže rozhoduje macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand hat darüber entschieden, daher entscheidet macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie ha decidido nada sobre ella, así que elige macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’a fait de choix pour elle : c’est donc macOS qui décide."
          }
        },
        "it" : {

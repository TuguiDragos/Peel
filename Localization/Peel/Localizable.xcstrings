          }
        }
      }
    },
    "It is in the Trash, but macOS didn’t say where, so it can only be put back from Finder." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je v koši, ale macOS neuvedl kde, takže ji lze vrátit zpět jen ve Finderu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist im Papierkorb, aber macOS hat nicht mitgeteilt, wo, daher kann es nur über den Finder zurückgelegt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en la papelera, pero macOS no ha dicho dónde, así que solo se puede sacar de la papelera desde el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est dans la corbeille, mais macOS n’a pas indiqué où : il ne peut donc être remis en place que depuis le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È nel Cestino, ma macOS non ha detto dove, quindi si può ripristinare solo dal Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱に入っていますが、macOSがその場所を報告しなかったため、Finderからしか戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통에 있지만 macOS가 위치를 알려 주지 않았으므로 Finder에서만 되돌려 놓을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het staat in de prullenmand, maar macOS heeft niet gemeld waar, dus het kan alleen vanuit Finder worden teruggezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest w Koszu, ale macOS nie podał, gdzie dokładnie, więc można to przywrócić tylko z Findera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está no Lixo, mas o macOS não disse onde, então só pode ser colocado de volta pelo Finder."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se află în Coș, dar macOS nu a spus unde, așa că poate fi pus înapoi doar din Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объект в Корзине, но macOS не сообщила, где именно, поэтому восстановить его можно только из Finder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ligger i papperskorgen, men macOS sa inte var, så det kan bara läggas tillbaka från Finder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp Sepeti’nde, ancak macOS nerede olduğunu söylemedi, bu yüzden yalnızca Finder’dan yerine konabilir."
          }
        },
        "uk" : {

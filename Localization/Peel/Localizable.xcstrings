    "Space doesn’t touch this: the app that made it knows what is still needed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stránka Místo na disku na toto nesahá: aplikace, která to vytvořila, ví, co je ještě potřeba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seite „Speicherplatz“ rührt dies nicht an: Die App, die es erstellt hat, weiß, was noch gebraucht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página Espacio no toca esto: la app que lo creó sabe lo que aún hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page Espace n’y touche pas : l’app qui l’a créé sait ce qui est encore nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagina Spazio non lo tocca: l’app che l’ha creato sa cosa serve ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“容量”ではこれに手を付けません。何がまだ必要かは、これを作成したアプリが把握しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간 페이지는 이 항목을 건드리지 않습니다. 무엇이 아직 필요한지는 이 항목을 만든 앱이 알고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De pagina 'Schijfruimte' komt hier niet aan: de app die dit heeft gemaakt, weet wat nog nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strona Miejsce tego nie dotyka: aplikacja, która to utworzyła, wie, co jest jeszcze potrzebne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A página Espaço não mexe nisso: o app que o criou sabe o que ainda é necessário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagina Spațiu nu atinge acest articol: aplicația care l‑a creat știe ce mai este necesar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раздел «Место на диске» не трогает эти данные: приложение, которое их создало, знает, что еще нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer dit uit in Terminal om de commandoregeltools voor ontwikkelaars van Apple te installeren, waaronder Git."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom to polecenie w Terminalu, aby zainstalować dostarczane przez Apple narzędzia wiersza polecenia dla deweloperów, które zawierają Gita."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute isto no Terminal para instalar as ferramentas de linha de comando para desenvolvedores da Apple, que incluem o Git."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulați această comandă în Terminal pentru a instala instrumentele de dezvoltare în linie de comandă de la Apple, care includ Git."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните эту команду в Терминале, чтобы установить инструменты командной строки для разработчиков от Apple, в состав которых входит Git."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör det här i Terminal för att installera Apples kommandoradsverktyg för utvecklare, som innehåller Git."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS по-прежнему считает этот пакет установленным, но от того, что он записал на диск, ничего не осталось."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

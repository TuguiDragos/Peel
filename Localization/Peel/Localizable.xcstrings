    "What stayed in the last removal is where it was, but it isn’t listed here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co při posledním odstranění zůstalo, je tam, kde bylo, ale není tu uvedeno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was beim letzten Entfernen geblieben ist, ist noch dort, wo es war, wird hier aber nicht angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que se quedó sin trasladar en la última eliminación sigue donde estaba, pero no aparece aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est resté en place lors de la dernière suppression s’y trouve toujours, mais n’est pas listé ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che è rimasto nell’ultima rimozione è ancora dov’era, ma non è elencato qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回ゴミ箱に入れた際に移動されなかった項目は元の場所にありますが、ここには表示されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 제거에서 그대로 남은 항목은 원래 위치에 있지만, 여기에는 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat bij de laatste verwijdering is blijven staan, staat nog op dezelfde plek, maar wordt hier niet vermeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co zostało przy ostatnim przeniesieniu do Kosza, jest tam, gdzie było, ale nie ma tego tutaj na liście."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que permaneceu na última remoção continua onde estava, mas não está listado aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce a rămas pe loc la ultima eliminare este tot acolo unde era, dar nu este listat aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что осталось на месте при последнем удалении, находится там же, где и было, но здесь не показывается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som blev kvar vid den senaste borttagningen ligger kvar där det var, men det finns inte med i listan här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son kaldırma işleminde taşınmayan öğeler hâlâ yerinde, ancak burada listelenmiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, що лишилося після останнього вилучення, досі на своєму місці, але тут не показується."
          }
        },
        "zh-Hans" : {

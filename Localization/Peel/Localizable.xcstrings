          }
        }
      }
    },
    "Peel kept the old file and continued with what it could still read. Items already in the Trash are still there: you can drag them back out in Finder." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel starý soubor ponechal a pokračoval s tím, co se ještě dalo přečíst. Položky, které už jsou v koši, tam stále jsou: ve Finderu je můžete přetáhnout zpět ven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel hat die alte Datei behalten und mit dem weitergemacht, was noch lesbar war. Objekte, die schon im Papierkorb liegen, sind weiterhin dort: Du kannst sie im Finder wieder herausziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel ha conservado el archivo antiguo y ha seguido con lo que aún podía leer. Los ítems que ya estaban en la papelera siguen ahí: puedes sacarlos arrastrándolos en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel a conservé l’ancien fichier et a continué avec ce qu’il pouvait encore lire. Les éléments déjà dans la corbeille y sont toujours : vous pouvez les en sortir dans le Finder, en les faisant glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel ha conservato il vecchio file ed è andato avanti con ciò che riusciva ancora a leggere. Gli elementi già nel Cestino sono ancora lì: puoi trascinarli fuori nel Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peelは古いファイルを保管し、読み取れた部分で処理を続けました。すでにゴミ箱にある項目はそのまま残っています。Finderでドラッグして取り出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel은 이전 파일을 보관한 채 아직 읽을 수 있는 내용으로 계속 진행했습니다. 이미 휴지통에 있는 항목은 그대로 있으므로 Finder에서 드래그하여 꺼낼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel heeft het oude bestand bewaard en is verdergegaan met wat nog leesbaar was. Onderdelen die al in de prullenmand stonden, staan er nog: je kunt ze in Finder er weer uit slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel zachował stary plik i korzysta z tego, co dało się jeszcze odczytać. Rzeczy, które już są w Koszu, nadal tam są: możesz przeciągnąć je z Kosza w Finderze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peel guardou o arquivo antigo e continuou com o que ainda conseguia ler. Os itens que já estavam no Lixo continuam lá: você pode arrastá-los para fora no Finder."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel a păstrat fișierul vechi și a continuat cu ce a mai putut citi. Articolele aflate deja în Coș sunt încă acolo: în Finder, le puteți trage afară din Coș."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel сохранил старый файл и продолжил работу с тем, что еще смог прочитать. Объекты, которые уже в Корзине, по-прежнему там: в Finder их можно перетащить из Корзины обратно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel behöll den gamla filen och fortsatte med det som fortfarande gick att läsa. Objekt som redan ligger i papperskorgen finns kvar där: du kan dra ut dem igen i Finder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel eski dosyayı sakladı ve hâlâ okuyabildikleriyle devam etti. Zaten Çöp Sepeti’nde olan öğeler hâlâ orada: onları Finder’da sürükleyerek dışarı çıkarabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel зберегла старий файл і працює далі з тим, що ще вдалося прочитати. Елементи, які вже в Смітнику, лишаються там: у Finder їх можна перетягнути зі Смітника назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel保留了旧文件，并继续使用其中仍可读取的部分。已在废纸篓中的项目仍在那里：你可以在“访达”中将它们拖出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel保留了舊檔案，並以仍可讀取的內容繼續運作。已在「垃圾桶」中的項目仍在那裡：你可以在Finder中將它們拖出來。"
          }
        }
      }
    },

    "Built for Intel processors only. On Apple silicon it needs Rosetta." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určeno jen pro procesory Intel. Na Macu s čipem Apple potřebuje prostředí Rosetta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Intel-Prozessoren entwickelt. Auf einem Mac mit Apple Chip benötigt es Rosetta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su código es solo para procesadores Intel. En un Mac con chip de Apple necesita Rosetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçu uniquement pour les processeurs Intel. Sur un Mac équipé d’une puce Apple, il nécessite Rosetta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per processori Intel. Sui Mac con chip Apple richiede Rosetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelプロセッサ専用にビルドされています。AppleシリコンではRosettaが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intel 프로세서 전용으로 빌드되었습니다. Apple silicon에서는 Rosetta가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen gemaakt voor Intel-processors. Op Apple silicon heeft het Rosetta nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skompilowano tylko dla procesorów Intel. Na Macu z układem scalonym Apple wymaga Rosetty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feito só para processadores Intel. Em um Mac com Apple silicon, precisa do Rosetta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar pentru procesoare Intel. Pe un Mac cu cip Apple are nevoie de Rosetta."

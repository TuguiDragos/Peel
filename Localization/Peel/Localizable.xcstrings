        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS는 이 패키지를 아직 설치된 것으로 간주하지만, 패키지가 디스크에 설치한 항목은 남아 있지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS beschouwt dit pakket nog als geïnstalleerd, maar van wat het op de schijf heeft gezet, is niets meer over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nadal uznaje ten pakiet za zainstalowany, ale nie zostało nic z tego, co umieścił na dysku."
          }
        },
        "pt" : {
          "stringUnit" : {

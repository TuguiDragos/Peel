        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce a instalat acest pachet fie este exclus în Configurări, fie se află într‑un dosar pe care Peel nu îl atinge niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что установил этот пакет, либо исключено в Настройках, либо находится в папке, которую Peel никогда не трогает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det som det här paketet installerade är antingen undantaget i Inställningar eller ligger i en mapp som Peel aldrig rör."

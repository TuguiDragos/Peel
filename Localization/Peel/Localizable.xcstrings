        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierul dvs. %@ își stabilește propriul prompt după linia Peel, așa că zsh îl afișează pe acesta."
          }
        },
        "ru" : {
          "stringUnit" : {

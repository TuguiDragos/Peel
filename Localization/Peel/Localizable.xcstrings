            "value" : "Peel发送的内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel傳送的內容"
          }
        }
      }
    },
    "What Stays" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co zůstane"
          }
        },
        "de" : {

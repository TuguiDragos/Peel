            "value" : "Daj aplikacji Peel pełny dostęp do dysku w Ustawieniach systemowych, aby zobaczyć, które pliki z iCloud są przechowywane na tym Macu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê ao Peel Acesso Total ao Disco nos Ajustes do Sistema para ver quais arquivos do iCloud estão guardados neste Mac."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordați aplicației Peel Acces complet la disc în Configurări sistem pentru a vedea ce fișiere iCloud sunt păstrate pe acest Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставьте Peel полный доступ к диску в Системных настройках, чтобы увидеть, какие файлы iCloud хранятся на этом Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge Peel full skivtillgång i Systeminställningar för att se vilka iCloud-filer som finns på den här datorn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

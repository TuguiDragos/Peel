          }
        }
      }
    },
    "This frees %@. Nothing is deleted from iCloud: the files stay there, Finder still lists them, and they download again when you open them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se uvolní %@. Z iCloudu se nic nesmaže: soubory tam zůstanou, Finder je bude dál zobrazovat a znovu se stáhnou, až je otevřete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gibt %@ frei. Es wird nichts aus iCloud gelöscht: Die Dateien bleiben dort, der Finder führt sie weiterhin auf, und sie werden wieder geladen, wenn du sie öffnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto libera %@. No se borra nada de iCloud: los archivos siguen ahí, el Finder los sigue mostrando y se vuelven a descargar cuando los abres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela libère %@. Rien n’est supprimé d’iCloud : les fichiers y restent, le Finder continue de les afficher, et ils sont à nouveau téléchargés lorsque vous les ouvrez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questo modo liberi %@. Non viene eliminato nulla da iCloud: i file restano lì, il Finder continua a elencarli e vengono scaricati di nuovo quando li apri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作で%@が解放されます。iCloudからは何も削除されません。ファイルはそのままiCloudに残り、Finderにも引き続き表示され、開くと再びダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 공간이 확보됩니다. iCloud에서는 아무것도 삭제되지 않습니다. 파일은 iCloud에 그대로 있고 Finder에도 계속 표시되며, 열면 다시 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee komt %@ vrij. Er wordt niets uit iCloud verwijderd: de bestanden blijven daar, Finder toont ze nog steeds en ze worden opnieuw gedownload wanneer je ze opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwolni to %@. Nic nie zostanie usunięte z iCloud: pliki tam pozostaną, Finder nadal będzie je pokazywać, a gdy je otworzysz, pobiorą się ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso libera %@. Nada é apagado do iCloud: os arquivos continuam lá, o Finder ainda os lista, e eles são baixados de novo quando você os abre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astfel se eliberează %@. Nu se șterge nimic de pe iCloud: fișierele rămân acolo, apar în continuare în Finder și se descarcă din nou când le deschideți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это освободит %@. Из iCloud ничего не удаляется: файлы остаются там, Finder по-прежнему их показывает, и они снова загружаются, когда Вы их открываете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här frigör %@. Inget raderas från iCloud: filerna finns kvar där, Finder visar dem fortfarande och de hämtas igen när du öppnar dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem %@ yer boşaltır. iCloud’dan hiçbir şey silinmez: dosyalar orada kalır, Finder’da listelenmeye devam eder ve onları açtığınızda yeniden indirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це звільнить %@. З iCloud нічого не видаляється: файли лишаються там, Finder і далі їх показує, і вони знову викачуються, коли ви їх відкриваєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会释放%@。不会从iCloud删除任何内容：文件仍保留在那里，“访达”也仍会列出它们，你打开时它们会重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會釋放%@。不會從iCloud刪除任何檔案：這些檔案會保留在iCloud中，Finder仍會列出它們，你打開時會重新下載。"
          }
        }
      }
    },

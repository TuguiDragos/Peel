    "Excluded in Settings (app)" : {
      "comment" : "Shown for an app the user excluded in Settings. Use the form that agrees with the word for an app.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {

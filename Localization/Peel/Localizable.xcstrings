          }
        }
      }
    },
    "macOS still counts this package as installed, but nothing it put on disk is left." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systém macOS tento balíček stále považuje za nainstalovaný, ale z toho, co umístil na disk, nic nezůstalo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS betrachtet dieses Paket noch als installiert, aber nichts von dem, was es abgelegt hat, ist noch da."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sigue contando este paquete como instalado, pero no queda nada de lo que puso en el disco."

        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk görüldüğünde %@ tarafından imzalanmıştı, şimdi %@ tarafından imzalanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",

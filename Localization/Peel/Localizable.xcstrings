    "Peel can’t look for duplicates in these folders." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V těchto složkách nemůže Peel hledat duplikáty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel kann in diesen Ordnern nicht nach Duplikaten suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel no puede buscar duplicados en estas carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel ne peut pas rechercher de doublons dans ces dossiers."
          }
        },
        "it" : {

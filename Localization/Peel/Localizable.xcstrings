        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分App的隱私權限未重置。"
          }
        }
      }
    },
    "Someone turned this off and macOS kept the choice." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Někdo toto rozšíření vypnul a macOS si tuto volbu zapamatoval."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat dies deaktiviert, und macOS hat sich die Entscheidung gemerkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien la desactivó y macOS guardó esa elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un l’a désactivée et macOS a conservé ce choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno l’ha disattivata e macOS ha mantenuto la scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かがこれをオフにし、macOSがその選択を保持しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 이 항목을 껐으며 macOS가 그 선택을 유지하고 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand heeft dit uitgeschakeld en macOS heeft die keuze bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś je wyłączył, a macOS zachował ten wybór."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém desativou isto e o macOS manteve a escolha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cineva a dezactivat‑o, iar macOS a păstrat alegerea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то выключил это расширение, и macOS запомнила этот выбор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Någon har stängt av det här och macOS har sparat valet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birisi bunu kapattı ve macOS bu seçimi korudu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хтось вимкнув це розширення, і macOS запамʼятала цей вибір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人关闭了它，macOS记住了这一选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人關閉了此項目，macOS保留了這個選擇。"
          }
        }
      }
    },

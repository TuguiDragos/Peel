    "%@ available of %@. Click to see what’s using it, under Space." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K dispozici %1$@ z %2$@. Klikněte a na stránce Místo na disku uvidíte, co disk zaplňuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ von %2$@ verfügbar. Klicke, um unter „Speicherplatz“ zu sehen, was den Speicher belegt."

    },
    "The latest release of Peel itself. Peel says when a new one is out and downloads nothing." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejnovější vydání samotného Peelu. Peel dá vědět, když vyjde nové, a nic nestahuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neueste Version von Peel selbst. Peel zeigt an, wenn eine neue verfügbar ist, und lädt nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión más reciente del propio Peel. Peel avisa cuando sale una nueva y no descarga nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière version de Peel lui-même. Peel indique quand une nouvelle version est disponible et ne télécharge rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultima versione di Peel stesso. Peel segnala quando ne è disponibile una nuova e non scarica nulla."

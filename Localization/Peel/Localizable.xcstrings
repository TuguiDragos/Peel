    "Code is loaded from that folder, so only what Peel’s helper took from it can go back." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z této složky se načítá kód, takže se do ní smí vrátit jen to, co z ní vzal pomocník Peelu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus diesem Ordner wird Code geladen, daher darf nur zurückgelegt werden, was das Hilfsprogramm von Peel daraus entnommen hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde esa carpeta se carga código, así que solo puede volver lo que el asistente de Peel sacó de allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du code est chargé depuis ce dossier : seul ce que l’utilitaire de Peel en a retiré peut donc y retourner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da quella cartella viene caricato del codice, quindi può tornarci solo ciò che l’assistente di Peel ne ha tolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのフォルダからはコードが読み込まれるため、戻せるのはPeelのヘルパーがそこから移動したものだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 폴더에서 코드가 로드되므로, Peel 보조 프로그램이 그 폴더에서 가져온 항목만 되돌려 놓을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanuit die map wordt code geladen, dus alleen wat het hulpprogramma van Peel eruit heeft gehaald, kan terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z tego folderu wczytywany jest kod, więc wrócić do niego może tylko to, co zabrał z niego pomocnik Peel."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa pasta é usada para carregar código, então só pode voltar para ela o que o auxiliar do Peel tirou de lá."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din acel dosar se încarcă cod, așa că poate fi pus înapoi în el doar ce a luat de acolo instrumentul de ajutor Peel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из этой папки загружается код, поэтому вернуть туда можно только то, что оттуда забрал помощник Peel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod läses in från den mappen, så bara det som Peels hjälpprogram har tagit därifrån kan läggas tillbaka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O klasörden kod yüklenir, bu yüzden oraya yalnızca Peel’in yardımcısının oradan aldıkları geri dönebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З цієї папки завантажується код, тож повернути туди можна лише те, що з неї забрав помічник Peel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统会从该文件夹载入代码，因此只有Peel的帮助程序从那里移走的内容才能放回去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統會從該檔案夾載入程式碼，因此只有Peel的輔助程式從中取出的項目才能放回去。"
          }
        }
      }
    },

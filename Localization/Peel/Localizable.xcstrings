    "Two hyphens stay two hyphens instead of becoming a long dash." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dva spojovníky zůstanou dvěma spojovníky a nezmění se v dlouhou pomlčku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Bindestriche bleiben zwei Bindestriche, statt zu einem langen Strich zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos guiones siguen siendo dos guiones en vez de convertirse en un guion largo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux traits d’union restent deux traits d’union au lieu de devenir un tiret long."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due trattini restano due trattini invece di diventare un trattino lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイフン2つが長いダッシュに変換されず、ハイフン2つのままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하이픈 두 개가 긴 대시로 바뀌지 않고 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee koppeltekens blijven twee koppeltekens in plaats van een lang streepje te worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa łączniki pozostają dwoma łącznikami, zamiast zmieniać się w długi myślnik."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois hifens continuam sendo dois hifens em vez de virarem um travessão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Două cratime rămân două cratime, în loc să devină o liniuță lungă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два дефиса остаются двумя дефисами и не превращаются в длинное тире."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två bindestreck förblir två bindestreck i stället för att bli ett långt tankstreck."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki kısa çizgi, uzun bir tireye dönüşmek yerine iki kısa çizgi olarak kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два дефіси лишаються двома дефісами, а не перетворюються на довге тире."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个连字符仍是两个连字符，而不会变成长破折号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩個連字號會維持為兩個連字號，不會變成長破折號。"
          }
        }
      }
    },

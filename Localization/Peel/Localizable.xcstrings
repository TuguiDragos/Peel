    "Saving the history locks the file the system’s way, so windows that save at the same time don’t damage it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při ukládání historie se soubor zamyká systémovým způsobem, takže ho okna, která ukládají ve stejnou chvíli, nepoškodí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Sichern des Verlaufs wird die Datei so gesperrt, wie das System es vorsieht, sodass Fenster, die gleichzeitig sichern, sie nicht beschädigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar el historial, el archivo se bloquea con el método del sistema, así que las ventanas que lo guardan a la vez no lo dañan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de l’historique verrouille le fichier à la manière du système, pour que des fenêtres qui enregistrent en même temps ne l’endommagent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salvataggio della cronologia blocca il file nel modo previsto dal sistema, così le finestre che salvano contemporaneamente non lo danneggiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴の保存時に、システム標準の方法でファイルをロックするため、複数のウインドウが同時に保存してもファイルが壊れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령 기록을 저장할 때 시스템 방식으로 파일을 잠그므로, 여러 윈도우가 동시에 저장해도 파일이 손상되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het bewaren van de geschiedenis wordt het bestand vergrendeld op de manier van het systeem, zodat vensters die tegelijk bewaren het niet beschadigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy zachowywaniu historii plik jest blokowany mechanizmem systemowym, więc okna zachowujące ją w tym samym czasie go nie uszkodzą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao salvar o histórico, o zsh bloqueia o arquivo pelo método do próprio sistema, para que janelas que salvam ao mesmo tempo não o danifiquem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salvarea istoricului, fișierul este blocat prin mecanismul sistemului, așa că ferestrele care salvează în același timp nu îl deteriorează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При сохранении истории файл блокируется средствами системы, поэтому окна, сохраняющие историю одновременно, не повредят его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När historiken sparas låses filen på systemets eget sätt, så att fönster som sparar samtidigt inte skadar den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş kaydedilirken dosya, sistemin kendi yöntemiyle kilitlenir; böylece aynı anda kaydeden pencereler dosyaya zarar vermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час збереження історії файл блокується засобами системи, тож вікна, які зберігають історію одночасно, не пошкодять його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存历史记录时会以系统的方式锁定文件，因此同时保存的多个窗口不会损坏该文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存指令記錄時會以系統的方式鎖定檔案，因此同時儲存的多個視窗不會損壞它。"
          }
        }
      }
    },

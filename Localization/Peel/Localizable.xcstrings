    "The path holds a character no real name has." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesta obsahuje znak, který žádný skutečný název nemá."
          }
        },
        "de" : {
          "stringUnit" : {

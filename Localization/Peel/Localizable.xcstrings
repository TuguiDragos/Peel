    "Quit %@ first, or it can write its own settings over these." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejprve ukončete aplikaci %@, jinak může tato nastavení přepsat svými vlastními."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende „%@“ zuerst, sonst kann die App ihre eigenen Einstellungen darüberschreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal primero de %@, o podría escribir sus propios ajustes encima de estos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez d’abord %@, sinon il risque d’écrire ses propres réglages par-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima esci da %@, altrimenti potrebbe scrivere le proprie impostazioni sopra queste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に“%@”を終了してください。終了しないと、アプリが独自の設定でこれらを上書きすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 ‘%@’을(를) 종료하십시오. 그렇지 않으면 앱이 이 설정 위에 자체 설정을 덮어쓸 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop eerst %@, anders kan de app de eigen instellingen hier overheen schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zakończ %@, bo w przeciwnym razie może zapisać własne ustawienia w miejsce tych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre %@ primeiro, senão ele pode gravar os próprios ajustes por cima destes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai întâi închideți %@, altfel își poate scrie propriile configurări peste acestea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала завершите приложение «%@», иначе оно может записать свои настройки поверх этих."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta %@ först, annars kan appen skriva sina egna inställningar över de här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce %@ uygulamasından çıkın, yoksa kendi ayarlarını bunların üzerine yazabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу завершіть програму «%@», інакше вона може записати власні налаштування поверх цих."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

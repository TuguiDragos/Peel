    "Can’t be read as a property list, so nothing can read these settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze ho přečíst jako seznam vlastností, takže tato nastavení nedokáže přečíst nic."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann nicht als Eigenschaftsliste gelesen werden, daher kann nichts diese Einstellungen lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer como lista de propiedades, así que nada puede leer estos ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier ne peut pas être lu comme une liste de propriétés : rien ne peut donc lire ces réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si può leggere come property list, quindi nessun programma può leggere queste impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロパティリストとして読み取れないため、この設定を読み取れるものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속성 목록으로 읽을 수 없으므로 어떤 프로그램도 이 설정을 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan niet als eigenschappenlijst worden gelezen, dus niets kan deze instellingen lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego pliku nie można odczytać jako listy właściwości, więc nic nie odczyta tych ustawień."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pode ser lido como lista de propriedades, por isso nada consegue ler estes ajustes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu poate fi citit ca listă de proprietăți, deci nimic nu poate citi aceste configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается прочитать как список свойств, поэтому эти настройки не может прочитать ни одна программа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte läsas som en egenskapslista, så ingenting kan läsa de här inställningarna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özellik listesi olarak okunamıyor, bu yüzden bu ayarları hiçbir şey okuyamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл не вдається прочитати як список властивостей, тож ці налаштування ніщо не може прочитати."

          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приложение или другой пакет либо папка внутри него, а все, что внутри пакета, принадлежит ему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den är en app eller ett annat paket, eller ligger i ett, och det som finns inuti hör till det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

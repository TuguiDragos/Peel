    "It belongs to another account, which could change what it runs." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patří jinému účtu, který by mohl změnit, co soubor spouští."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei gehört einem anderen Benutzeraccount, der ändern könnte, was sie ausführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertenece a otra cuenta, que podría cambiar lo que ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il appartient à un autre compte, qui pourrait modifier ce qu’il exécute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appartiene a un altro account, che potrebbe cambiare ciò che il file esegue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアカウントのファイルなので、実行される内容をそのアカウントが変更できる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 계정의 파일이므로 그 계정이 이 파일이 실행하는 내용을 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hoort bij een andere account, die kan wijzigen wat het uitvoert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Należy do innego konta, a to konto mogłoby zmienić to, co ten plik uruchamia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele pertence a outra conta, que poderia alterar o que ele executa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparține altui cont, care ar putea schimba ce rulează acest fișier."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он принадлежит другой учетной записи, которая может изменить то, что он запускает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tillhör ett annat konto, som kan ändra vad den kör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir hesaba ait ve o hesap, dosyanın ne çalıştırdığını değiştirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл належить іншому обліковому запису, який може змінити те, що він виконує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它属于另一个账户，该账户可能会更改它所运行的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它屬於另一個帳號，該帳號可能會變更它所執行的內容。"
          }
        }
      }
    },
    "It came inside an app, and it goes when that app goes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přišlo jako součást aplikace a zmizí spolu s ní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Erweiterung kam als Teil einer App und verschwindet zusammen mit ihr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vino dentro de una app y desaparece cuando esa app desaparece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est arrivée à l’intérieur d’une app, et disparaît avec cette app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È arrivata dentro un’app e se ne va insieme a quell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリに含まれていたもので、そのアプリがなくなると一緒になくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에 포함되어 설치되었으며, 앱이 제거되면 함께 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het zit in een app en verdwijnt samen met die app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostało dostarczone w aplikacji i zniknie razem z nią."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veio dentro de um app e vai embora junto com ele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A venit în interiorul unei aplicații și dispare odată cu aceasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это расширение поставляется внутри приложения и удаляется вместе с ним."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kom inuti en app, och det försvinner när den appen försvinner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulamanın içinde geldi ve o uygulama gidince o da gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це розширення постачається всередині програми і зникає разом із нею."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它包含在某个App中，该App移除时它也会随之移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它隨附在App中，該App移除時它也會一併移除。"
          }
        }
      }
    },
    "It can’t be read as a property list, or it names no job, so macOS never loads it and nothing runs from it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze ho přečíst jako seznam vlastností, nebo neuvádí žádnou úlohu, takže ho systém macOS nikdy nenačte a nic se z něj nespouští."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei kann nicht als Eigenschaftsliste gelesen werden oder nennt keinen Job, daher lädt macOS sie nie, und es wird nichts aus ihr ausgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer como lista de propiedades o no nombra ninguna tarea, así que macOS nunca lo carga y no se ejecuta nada desde él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne peut pas être lu comme une liste de propriétés, ou il ne désigne aucune tâche : macOS ne le charge donc jamais, et rien ne s’exécute à partir de ce fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si può leggere come property list, oppure non indica alcun elemento, quindi macOS non lo carica mai e da esso non viene eseguito nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロパティリストとして読み取れないか、ジョブが指定されていないため、macOSがこのファイルを読み込むことはなく、このファイルから実行されるものもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "속성 목록으로 읽을 수 없거나 작업을 지정하지 않으므로 macOS가 이 파일을 불러오지 않으며, 이 파일로 실행되는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kan niet als eigenschappenlijst worden gelezen, of het noemt geen taak, dus macOS laadt het nooit en er wordt niets mee uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można go odczytać jako listy właściwości albo nie wskazuje żadnego zadania, więc macOS nigdy go nie wczytuje i nic z niego nie jest uruchamiane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pode ser lido como lista de propriedades, ou não nomeia nenhuma tarefa, por isso o macOS nunca o carrega e nada é executado a partir dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu poate fi citit ca listă de proprietăți sau nu denumește nicio sarcină, deci macOS nu îl încarcă niciodată și nimic nu rulează din el."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его не удается прочитать как список свойств, или в нем не указано задание, поэтому macOS никогда его не загружает и из него ничего не запускается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan inte läsas som en egenskapslista, eller så anger den inget jobb, så macOS läser aldrig in den och ingenting körs från den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özellik listesi olarak okunamıyor veya hiçbir iş belirtmiyor, bu yüzden macOS onu hiçbir zaman yüklemez ve ondan hiçbir şey çalışmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його не вдається прочитати як список властивостей, або в ньому не названо жодного завдання, тож macOS ніколи його не завантажує і з нього нічого не запускається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它无法作为属性列表读取，或者没有指明任何任务，因此macOS从不载入它，也不会有任何内容从它运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將它讀取為屬性列表，或它未指名任何工作，因此macOS永遠不會載入它，也不會從它執行任何東西。"
          }
        }
      }
    },
    "It changed after Peel looked at it. Scan again to review it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změnila se poté, co ji Peel prověřil. Prohledejte znovu a zkontrolujte ji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hat sich geändert, nachdem Peel es angesehen hat. Scanne erneut, um es zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha cambiado después de que Peel lo revisara. Vuelve a analizar para revisarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a été modifié après que Peel l’a examiné. Relancez l’analyse pour le vérifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È cambiato dopo che Peel l’ha esaminato. Analizza di nuovo per rivederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peelが確認した後に変更されました。もう一度スキャンして確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel이 살펴본 후에 변경되었습니다. 다시 스캔하여 검토하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is gewijzigd nadat Peel ernaar keek. Scan opnieuw om het te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniło się po tym, jak Peel to sprawdził. Przeskanuj ponownie, aby to przejrzeć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudou depois que o Peel o examinou. Analise de novo para revisá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S‑a modificat după ce l‑a examinat Peel. Scanați din nou pentru a‑l revizui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объект изменился после того, как Peel его проверил. Просканируйте снова, чтобы просмотреть его заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ändrades efter att Peel tittade på det. Skanna igen för att granska det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel baktıktan sonra değişti. Gözden geçirmek için yeniden tarayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Елемент змінився після перевірки Peel. Проскануйте знову, щоб переглянути його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel查看后它发生了变化。请重新扫描以检查它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在Peel查看後有所變更。請重新掃描以檢查。"
          }
        }
      }
    },
    "It doesn’t pass Gatekeeper, the check macOS makes before it opens an app." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprojde Gatekeeperem, tedy kontrolou, kterou macOS provádí před otevřením aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es besteht die Gatekeeper-Prüfung nicht, die macOS vor dem Öffnen einer App vornimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No supera Gatekeeper, la comprobación que hace macOS antes de abrir una app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne répond pas aux critères de Gatekeeper, la vérification que macOS effectue avant d’ouvrir une app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non supera Gatekeeper, il controllo che macOS esegue prima di aprire un’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper（macOSがアプリを開く前に行う確認）を通過しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 앱을 열기 전에 수행하는 확인 절차인 Gatekeeper를 통과하지 못합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het komt niet door Gatekeeper, de controle die macOS uitvoert voordat een app wordt geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie przechodzi kontroli Gatekeeper, którą macOS przeprowadza przed otwarciem aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pacote não passa pelo Gatekeeper, a verificação que o macOS faz antes de abrir um app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu trece de Gatekeeper, verificarea pe care o face macOS înainte de a deschide o aplicație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

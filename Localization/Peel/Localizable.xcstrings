    "The items are in the Trash. You can drag them back out in Finder." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky jsou v koši. Ve Finderu je můžete přetáhnout zpět ven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

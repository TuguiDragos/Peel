    "Stage, commit, branch, rebase, and resolve conflicts from a full interface in Terminal. Run `lazygit` in a repository." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V plnohodnotném rozhraní v Terminálu můžete připravovat změny ke commitu, vytvářet commity a větve, provádět rebase a řešit konflikty. V repozitáři spusťte `lazygit`."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über eine vollständige Oberfläche im Terminal kannst du stagen, committen, Branches anlegen, rebasen und Konflikte lösen. Führe `lazygit` in einem Repository aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara cambios, haz commits, crea ramas, haz rebase y resuelve conflictos desde una interfaz completa en Terminal. Ejecuta `lazygit` en un repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indexez, faites des commits, créez des branches, rebasez et résolvez les conflits depuis une interface complète dans Terminal. Exécutez `lazygit` dans un dépôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da un’interfaccia completa in Terminale puoi fare stage e commit, creare branch, eseguire rebase e risolvere i conflitti. Esegui `lazygit` in un repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナル内のフル機能のインターフェイスで、ステージ、コミット、ブランチ操作、リベース、コンフリクトの解決を行えます。リポジトリ内で`lazygit`を実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 안의 완전한 인터페이스에서 스테이징, 커밋, 브랜치 작업, 리베이스, 충돌 해결을 할 수 있습니다. 저장소에서 `lazygit`을 실행하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee kun je stagen, committen, branches maken, rebasen en conflicten oplossen vanuit een volledige interface in Terminal. Voer `lazygit` uit in een repository."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj zmiany do indeksu, twórz commity i gałęzie, wykonuj rebase i rozwiązuj konflikty z poziomu pełnego interfejsu w Terminalu. Uruchom `lazygit` w repozytorium."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça stage, commit e rebase, crie branches e resolva conflitos em uma interface completa no Terminal. Execute `lazygit` em um repositório."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faceți stage și commit, creați branch‑uri, faceți rebase și rezolvați conflicte dintr‑o interfață completă în Terminal. Rulați `lazygit` într‑un depozit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индексация изменений, коммиты, ветки, перебазирование и разрешение конфликтов в полноценном интерфейсе в Терминале. Запустите `lazygit` в репозитории."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köa ändringar, checka in, skapa grenar, ombasera och lös konflikter i ett komplett gränssnitt i Terminal. Kör `lazygit` i ett kodförråd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal’deki eksiksiz bir arayüzden değişiklikleri stage’e alın, commit edin, dallarla çalışın, rebase yapın ve çakışmaları çözün. Bir depoda `lazygit` komutunu çalıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Індексуйте зміни, фіксуйте їх, створюйте гілки, перебазовуйте й розвʼязуйте конфлікти в повноцінному інтерфейсі в Терміналі. Запустіть `lazygit` у репозиторії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“终端”中的完整界面里暂存、提交、管理分支、变基和解决冲突。在代码仓库中运行`lazygit`即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「終端機」中透過完整的介面暫存、提交、建立分支、rebase及解決衝突。請在儲存庫中執行`lazygit`。"
          }
        }
      }
    },

    "A full copy of macOS, ready to install. Apple offers the newest release again to any Mac that can run it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úplná kopie systému macOS připravená k instalaci. Apple nejnovější verzi znovu nabídne každému Macu, který ji dokáže spustit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vollständige Kopie von macOS, bereit zur Installation. Apple bietet die neueste Version jedem Mac, der sie ausführen kann, erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia completa de macOS, lista para instalar. Apple vuelve a ofrecer la versión más reciente a cualquier Mac que pueda ejecutarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie complète de macOS, prête à être installée. Apple propose à nouveau la version la plus récente à tout Mac capable de l’exécuter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia completa di macOS, pronta da installare. Apple offre di nuovo l’ultima versione a qualsiasi Mac in grado di eseguirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐにインストールできる、macOSの完全なコピーです。Appleは、最新のリリースを実行できるすべてのMacに、そのリリースを再び提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바로 설치할 수 있는 macOS 전체 복사본입니다. Apple은 최신 버전을 실행할 수 있는 모든 Mac에 최신 버전을 다시 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een volledige kopie van macOS, klaar om te installeren. Apple biedt de nieuwste versie opnieuw aan voor elke Mac die er geschikt voor is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełna kopia macOS, gotowa do instalacji. Apple ponownie udostępnia najnowsze wydanie każdemu Macowi, który może je uruchomić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cópia completa do macOS, pronta para instalar. A Apple oferece a versão mais recente de novo a qualquer Mac que possa executá-la."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O copie completă a macOS, gata de instalare. Apple oferă din nou cea mai nouă versiune oricărui Mac care o poate rula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полная копия macOS, готовая к установке. Apple снова предлагает новейший выпуск любому Mac, который может его запустить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fullständig kopia av macOS, redo att installeras. Apple erbjuder den senaste versionen igen till alla Mac-datorer som kan köra den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

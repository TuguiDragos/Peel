            "value" : "Homebrew kan inte längre hämta det på ett tillförlitligt sätt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew artık onu güvenilir bir şekilde indiremiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew більше не може надійно його викачувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew已无法可靠地下载它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew已無法穩定地下載此套件。"

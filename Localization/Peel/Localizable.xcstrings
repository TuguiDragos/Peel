    "%@ came with macOS. Software Update is what keeps it current, so Peel has nothing to ask." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ je součástí systému macOS. Aktuální ji udržuje Aktualizace softwaru, takže se Peel nemá na co ptát."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde mit macOS geliefert. „Softwareupdate“ hält die App auf dem neuesten Stand, daher hat Peel nichts zu fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene con macOS. Actualización de software es lo que la mantiene al día, así que Peel no tiene nada que preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est fourni avec macOS. C’est Mise à jour de logiciels qui le maintient à jour : Peel n’a donc rien à demander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è inclusa in macOS. È “Aggiornamento software” a mantenerla aggiornata, quindi Peel non ha nulla da chiedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はmacOSに付属しています。これを最新の状態に保つのは“ソフトウェアアップデート”のため、Peelが問い合わせることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) macOS에 포함된 앱입니다. 소프트웨어 업데이트가 이 앱을 최신 상태로 유지하므로 Peel이 물어볼 곳이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is met macOS meegeleverd. 'Software-update' houdt het up-to-date, dus Peel hoeft niets te vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ została dostarczona z macOS i jest uaktualniana w sekcji Uaktualnienia w Ustawieniach systemowych, więc Peel nie ma o co pytać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ veio com o macOS. É a Atualização de Software que o mantém atualizado, então o Peel não tem nada a perguntar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația %@ a venit cu macOS. Actualizare software o ține la zi, așa că Peel nu are ce întreba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение «%@» входит в macOS. За его обновления отвечает «Обновление ПО», поэтому Peel не о чем спрашивать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ följde med macOS. Det är Programuppdatering som håller appen aktuell, så Peel har inget att fråga om."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS ile birlikte geldi. Onu güncel tutan Yazılım Güncelleme’dir, bu yüzden Peel’in soracak bir şeyi yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма «%@» постачається з macOS. Її оновлює розділ «Оновлення системи», тож Peel нема про що запитувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”随macOS附带，由“软件更新”保持最新，因此Peel无需查询。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」是macOS內建的App。它由「軟體更新」保持最新狀態，因此Peel無需詢問。"
          }
        }
      }
    },

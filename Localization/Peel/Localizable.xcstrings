    "Icons never bounce for attention" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikony nikdy neposkakují, aby upoutaly pozornost"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbole hüpfen nie, um Aufmerksamkeit zu erregen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los iconos nunca rebotan para llamar la atención"
          }
        },
        "fr" : {
          "stringUnit" : {

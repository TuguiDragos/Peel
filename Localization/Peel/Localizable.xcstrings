        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel se queda en la barra de menús después de que cierres su ventana, con lo que ha encontrado cada herramienta y las actualizaciones pendientes. Con esto desactivado, Peel se cierra cuando cierras su ventana."
          }

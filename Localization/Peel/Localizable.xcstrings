    "Starts Peel when you log in. “Watch the Trash” works only while Peel is running." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí Peel, když se přihlásíte. Volba „Sledovat koš“ funguje, jen když Peel běží."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet Peel, wenn du dich anmeldest. „Papierkorb beobachten“ funktioniert nur, während Peel läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Peel al iniciar sesión. “Vigilar la papelera” solo funciona mientras Peel está en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Peel lorsque vous ouvrez une session. « Surveiller la corbeille » ne fonctionne que lorsque Peel est en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia Peel quando esegui il login. “Monitora il Cestino” funziona solo mentre Peel è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時にPeelを起動します。“ゴミ箱を監視”は、Peelの実行中にのみ機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인할 때 Peel을 시작합니다. ‘휴지통 지켜보기’는 Peel이 실행 중일 때만 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start Peel wanneer je inlogt. 'Houd prullenmand in de gaten' werkt alleen zolang Peel actief is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia Peel podczas logowania. „Obserwuj Kosz” działa tylko wtedy, gdy Peel jest uruchomiony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o Peel quando você inicia a sessão. “Monitorar o Lixo” só funciona enquanto o Peel estiver em execução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",

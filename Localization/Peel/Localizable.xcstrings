    "The tool didn’t answer in time, so it was stopped." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nástroj neodpověděl včas, a proto byl zastaven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tool hat nicht rechtzeitig geantwortet, daher wurde es gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta no ha respondido a tiempo, así que se ha detenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ítems están en la papelera. Puedes sacarlos arrastrándolos en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

    "It is in iCloud Drive or another cloud folder, which Peel leaves to the app that syncs it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je na iCloud Drivu nebo v jiné cloudové složce, kterou Peel přenechává aplikaci, jež ji synchronizuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner liegt in iCloud Drive oder einem anderen Cloud-Ordner, den Peel der App überlässt, die ihn synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en iCloud Drive o en otra carpeta en la nube, que Peel deja en manos de la app que la sincroniza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se trouve dans iCloud Drive ou dans un autre dossier dans le cloud, que Peel laisse à l’app qui le synchronise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trova in iCloud Drive o in un’altra cartella cloud, che Peel lascia all’app che la sincronizza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Driveまたはほかのクラウドフォルダにあり、Peelはそれを同期しているアプリに任せています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive나 다른 클라우드 폴더에 있습니다. Peel은 이러한 폴더를 동기화하는 앱에 맡깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

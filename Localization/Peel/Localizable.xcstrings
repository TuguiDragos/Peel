          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel zapisuje je we własnym pliku, który odczytuje zsh. Wyłączenie któregoś z nich usuwa je z tego pliku, a Twój plik ~/.zshrc pozostaje bez zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

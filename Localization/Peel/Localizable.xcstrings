        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De privacytoestemmingen van de app zijn niet opnieuw ingesteld. %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wyzerowano uprawnień prywatności aplikacji. %@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões de privacidade do app não foram redefinidas. %@"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permisiunile de intimitate ale aplicației nu au fost resetate. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его разрешения на доступ не сброшены. %@"
          }
        },
        "sv" : {

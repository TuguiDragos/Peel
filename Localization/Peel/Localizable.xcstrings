          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel bunları kendine ait bir dosyaya yazar ve zsh bu dosyayı okur. Birini kapatmak onu bu dosyadan çıkarır; ~/.zshrc dosyanız ise olduğu gibi kalır."
          }

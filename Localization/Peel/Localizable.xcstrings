    "A name can’t have a slash or a colon in it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název nemůže obsahovat lomítko ani dvojtečku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Name darf weder einen Schrägstrich noch einen Doppelpunkt enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre no puede contener una barra “/” ni dos puntos “:”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom ne peut contenir ni barre oblique ni deux-points."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome non può contenere una barra né i due punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前にスラッシュまたはコロンを含めることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름에는 슬래시나 콜론을 포함할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een naam mag geen schuine streep of dubbele punt bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa nie może zawierać ukośnika ani dwukropka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um nome não pode ter barra nem dois-pontos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nume nu poate conține o bară oblică „/” sau două puncte „:”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя не может содержать косую черту или двоеточие."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett namn får inte innehålla snedstreck eller kolon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad, eğik çizgi veya iki nokta üst üste içeremez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назва не може містити скісну риску або двокрапку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称中不能包含斜线或冒号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名稱不能包含斜線或冒號。"
          }
        }
      }
    },
    "A name can’t start with a period, or the screenshots would be hidden." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název nemůže začínat tečkou, jinak by snímky obrazovky byly skryté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Name darf nicht mit einem Punkt beginnen, sonst wären die Bildschirmfotos ausgeblendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre no puede empezar por un punto, porque las capturas de pantalla quedarían ocultas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom ne peut pas commencer par un point, sinon les captures d’écran seraient masquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome non può iniziare con un punto, altrimenti gli screenshot sarebbero nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前をピリオドで始めることはできません。ピリオドで始めると、スクリーンショットが非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름은 마침표로 시작할 수 없습니다. 마침표로 시작하면 스크린샷이 숨겨집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een naam mag niet met een punt beginnen, anders zouden de schermafbeeldingen verborgen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa nie może zaczynać się od kropki, bo w przeciwnym razie zrzuty ekranu byłyby ukryte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um nome não pode começar com um ponto, senão as capturas de tela ficariam ocultas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nume nu poate începe cu un punct „.”, altfel capturile de ecran ar fi ascunse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя не может начинаться с точки, иначе снимки экрана будут скрыты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett namn får inte börja med en punkt, annars skulle skärmavbilderna bli gömda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad, nokta ile başlayamaz, yoksa ekran resimleri gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назва не може починатися з крапки, інакше знімки екрана були б приховані."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称不能以句点开头，否则截屏会被隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名稱不能以句點開頭，否則截圖會隱藏起來。"
          }
        }
      }
    },
    "A new connection to a server you’re already connected to opens at once through the first, which stays open 10 minutes after the last one ends. Leave it off if you use two accounts on one server, such as two GitHub accounts: ssh would send the second through the first one’s connection." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové připojení k serveru, ke kterému jste už připojeni, se okamžitě otevře přes to první, které zůstane otevřené ještě 10 minut po ukončení posledního. Nechte tuto volbu vypnutou, pokud na jednom serveru používáte dva účty, například dva účty GitHub: ssh by připojení druhého účtu poslal přes připojení prvního."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Verbindung zu einem Server, mit dem du schon verbunden bist, öffnet sich sofort über die erste, die nach dem Ende der letzten noch 10 Minuten offen bleibt. Lass diese Option deaktiviert, wenn du zwei Accounts auf demselben Server verwendest, etwa zwei GitHub-Accounts: ssh würde die Verbindung des zweiten über die des ersten leiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una conexión nueva a un servidor al que ya estás conectado se abre al instante a través de la primera, que sigue abierta 10 minutos después de que termine la última. Déjalo desactivado si usas dos cuentas en un mismo servidor, como dos cuentas de GitHub: ssh enviaría la segunda a través de la conexión de la primera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle connexion à un serveur auquel vous êtes déjà connecté s’ouvre aussitôt en passant par la première, qui reste ouverte 10 minutes après la fin de la dernière. Laissez ce réglage désactivé si vous utilisez deux comptes sur un même serveur, comme deux comptes GitHub : ssh ferait passer le second compte par la connexion du premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando hai già una connessione con un server, una nuova connessione allo stesso server si apre subito attraverso la prima, che resta aperta per 10 minuti dopo la chiusura dell’ultima. Lascia disattivata questa opzione se usi due account sullo stesso server, come due account GitHub: ssh farebbe passare il secondo attraverso la connessione del primo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに接続しているサーバへの新しい接続は、最初の接続を通じてすぐに開きます。最初の接続は、最後の接続が終了してから10分間開いたままになります。2つのGitHubアカウントなど、1つのサーバで2つのアカウントを使う場合は、オフのままにしてください。オンにすると、sshは2つ目のアカウントの接続を、最初のアカウントの接続を通じて開いてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 연결된 서버에 새로 연결하면 첫 번째 연결을 통해 바로 열리며, 첫 번째 연결은 마지막 연결이 끝난 후에도 10분 동안 열려 있습니다. GitHub 계정 두 개처럼 한 서버에서 계정 두 개를 사용한다면 이 설정을 끈 상태로 두십시오. 켜 두면 ssh가 두 번째 계정의 연결을 첫 번째 계정의 연결을 통해 보냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nieuwe verbinding met een server waarmee je al verbonden bent, wordt meteen geopend via de eerste, die nog 10 minuten open blijft nadat de laatste verbinding is beëindigd. Laat dit uitgeschakeld als je twee accounts op één server gebruikt, zoals twee GitHub-accounts: ssh zou de tweede dan via de verbinding van de eerste sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe połączenie z serwerem, z którym masz już połączenie, otwiera się od razu przez to pierwsze, które pozostaje otwarte jeszcze 10 minut po zakończeniu ostatniego. Pozostaw tę opcję wyłączoną, jeśli używasz dwóch kont na jednym serwerze, na przykład dwóch kont GitHub: ssh skierowałby drugie konto przez połączenie pierwszego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova conexão com um servidor ao qual você já está conectado abre na hora por meio da primeira conexão, que fica aberta por 10 minutos depois que a última termina. Deixe esta opção desativada se você usa duas contas no mesmo servidor, como duas contas do GitHub: o ssh enviaria a segunda conta pela conexão da primeira."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O conexiune nouă la un server la care sunteți deja conectat se deschide imediat prin prima, care rămâne deschisă 10 minute după ce se încheie ultima. Lăsați această opțiune dezactivată dacă folosiți două conturi pe același server, de exemplu două conturi GitHub: ssh ar trimite conexiunea celui de‑al doilea cont prin cea a primului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое подключение к серверу, к которому Вы уже подключены, сразу открывается через первое подключение. Оно остается открытым еще 10 минут после завершения последнего. Оставьте этот параметр выключенным, если Вы используете две учетные записи на одном сервере, например две учетные записи GitHub: ssh направит подключение второй через подключение первой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny anslutning till en server som du redan är ansluten till öppnas direkt via den första, som hålls öppen i 10 minuter efter att den sista har avslutats. Låt inställningen vara avstängd om du använder två konton på samma server, till exempel två GitHub-konton: ssh skulle då skicka det andra via det förstas anslutning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten bağlı olduğunuz bir sunucuya açılan yeni bir bağlantı ilkinin üzerinden hemen açılır; ilk bağlantı da sonuncusu kapandıktan sonra 10 dakika açık kalır. Aynı sunucuda iki hesap (örneğin iki GitHub hesabı) kullanıyorsanız bunu kapalı bırakın: açıkken ssh, ikinci hesabı ilk hesabın bağlantısı üzerinden gönderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нове зʼєднання із сервером, до якого ви вже підʼєднані, відкривається відразу через перше зʼєднання, яке лишається відкритим ще 10 хвилин після того, як завершиться останнє. Не вмикайте цей параметр, якщо використовуєте два облікові записи на одному сервері, як-от два облікові записи GitHub: ssh підʼєднував би другий через зʼєднання першого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接到你已连接的服务器时，新连接会通过第一个连接立即打开，而第一个连接会在最后一个连接结束后继续保持打开10分钟。如果你在同一台服务器上使用两个账户（例如两个GitHub账户），请保持此项关闭：ssh会通过第一个账户的连接发送第二个账户的连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對你已連線的伺服器建立的新連線，會立即透過第一條連線開啟；第一條連線會在最後一條連線結束後再保持開啟10分鐘。如果你在同一部伺服器上使用兩個帳號，例如兩個GitHub帳號，請讓此選項保持關閉：ssh會透過第一個帳號的連線傳送第二個帳號的連線。"
          }
        }
      }
    },
    "A package Homebrew is in the middle of installing may be left half installed, and may need installing again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balíček, který Homebrew právě instaluje, může zůstat napůl nainstalovaný a možná ho bude potřeba nainstalovat znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Paket, das Homebrew gerade installiert, bleibt möglicherweise nur teilweise installiert und muss eventuell erneut installiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paquete que Homebrew esté instalando en este momento puede quedar a medio instalar, y puede que haya que volver a instalarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paquet que Homebrew est en train d’installer pourrait rester partiellement installé, et il faudrait peut-être le réinstaller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pacchetto che Homebrew sta installando potrebbe restare installato a metà e dover essere reinstallato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewがインストールしている途中のパッケージは、不完全にインストールされたままになり、再インストールが必要になる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew가 설치 중인 패키지는 일부만 설치된 상태로 남을 수 있으며, 다시 설치해야 할 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een pakket dat Homebrew nog aan het installeren is, kan half geïnstalleerd achterblijven en moet dan misschien opnieuw worden geïnstalleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakiet, który Homebrew właśnie instaluje, może zostać zainstalowany częściowo i może wymagać ponownej instalacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pacote que o Homebrew estiver instalando no momento pode ficar instalado pela metade, e talvez precise ser instalado de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pachet pe care Homebrew încă îl instalează poate rămâne instalat pe jumătate și poate fi necesar să fie instalat din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет, который Homebrew устанавливает в этот момент, может остаться установленным наполовину, и его, возможно, придется установить снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett paket som Homebrew håller på att installera kan bli halvt installerat och behöva installeras igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew’un yüklemekte olduğu bir paket yarım yüklenmiş hâlde kalabilir ve yeniden yüklenmesi gerekebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакет, який Homebrew саме інсталює, може залишитися інстальованим лише частково, і його, можливо, доведеться інсталювати знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew正在安装的软件包可能只安装了部分，之后可能需要重新安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew正在安裝的套件可能只有一部分完成安裝，因此可能需要重新安裝。"
          }
        }
      }
    },
    "A page jumps to where you sent it instead of gliding." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stránka místo plynulého posunu skočí rovnou tam, kam jste ji poslali."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Seite springt direkt dorthin, wohin du sie schickst, statt zu gleiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una página salta adonde la envías en vez de deslizarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une page saute directement à l’endroit voulu au lieu de glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pagina salta dove l’hai mandata invece di scivolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページが滑らかに動かずに、指定した位置へすぐに移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이지가 미끄러지듯 움직이지 않고 원하는 위치로 바로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een pagina springt meteen naar de plek waar je heen wilt, in plaats van erheen te glijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strona od razu przeskakuje we wskazane miejsce, zamiast płynnie się przesuwać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma página salta para onde você a mandou, em vez de deslizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagină sare direct unde ați trimis‑o, în loc să alunece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Страница сразу перескакивает туда, куда Вы ее прокрутили, а не плавно скользит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sida hoppar dit du skickar den i stället för att glida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfa kayarak gitmek yerine gönderdiğiniz yere atlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сторінка одразу перескакує туди, куди ви її прокрутили, замість плавного руху."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面会直接跳到你要去的位置，而不是平滑滑动过去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頁面會直接跳到你指定的位置，而不會平滑滑動過去。"
          }
        }
      }
    },
    "A program is using it, as the desktop picture is used, so macOS couldn’t remove its download. Try again once nothing uses it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento soubor používá nějaký program, stejně jako se používá tapeta, takže systém macOS nemohl odstranit jeho staženou kopii. Zkuste to znovu, až ho nebude nic používat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Programm verwendet diese Datei, so wie das Hintergrundbild verwendet wird, daher konnte macOS ihren Download nicht entfernen. Versuche es erneut, sobald nichts sie mehr verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa lo está usando, como ocurre con el fondo de pantalla, así que macOS no ha podido eliminar su descarga. Vuelve a intentarlo cuando nada lo esté usando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme l’utilise, comme c’est le cas du fond d’écran, si bien que macOS n’a pas pu retirer son téléchargement. Réessayez une fois que plus rien ne l’utilise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programma lo sta usando, come succede con lo sfondo della scrivania, quindi macOS non è riuscito a rimuoverne il download. Riprova quando non lo usa più nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップの壁紙と同じように、プログラムがこのファイルを使用中のため、macOSはダウンロードしたものを削除できませんでした。使用しているものがなくなったら、もう一度やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면으로 표시 중인 사진처럼 어떤 프로그램이 이 파일을 사용하고 있어 macOS가 다운로드를 제거할 수 없습니다. 이 파일을 사용하는 항목이 없을 때 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een programma gebruikt dit bestand, zoals de bureaubladachtergrond wordt gebruikt, dus macOS kon de download ervan niet verwijderen. Probeer het opnieuw zodra niets het meer gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakiś program używa tego pliku, tak jak używana jest tapeta, więc macOS nie mógł usunąć jego pobranej kopii. Spróbuj ponownie, gdy nic nie będzie go już używać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um programa está usando este arquivo, como acontece com a imagem de fundo, então o macOS não conseguiu remover o download dele. Tente novamente quando nada estiver usando o arquivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierul este folosit de un program, așa cum este folosită imaginea desktopului, așa că macOS nu i‑a putut elimina descărcarea. Încercați din nou când nimic nu îl mai folosește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл использует какая-то программа, как это бывает с обоями рабочего стола, поэтому macOS не удалось удалить его загруженную копию. Повторите попытку, когда файл ничем не будет использоваться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett program använder filen, på samma sätt som skrivbordsbilden används, så macOS kunde inte ta bort hämtningen. Försök igen när inget använder den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir program bu dosyayı, masaüstü resminin kullanıldığı gibi kullanıyor; bu yüzden macOS indirilen kopyasını kaldıramadı. Hiçbir şey onu kullanmadığında yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей файл використовує якась програма, як це буває зі шпалерою, тож macOS не вдалося вилучити його викачування. Спробуйте ще раз, коли його ніщо не використовуватиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个程序正在使用此文件，就像桌面墙纸被使用那样，因此macOS无法移除它的下载。请在没有任何程序使用它后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某個程式正在使用它，就像桌面背景圖片被使用時一樣，因此macOS無法移除它的下載項目。請在沒有任何程式使用它時再試一次。"
          }
        }
      }
    },
    "A rebase puts uncommitted changes aside and brings them back when it ends." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebase odloží změny, které ještě nejsou v commitu, a až skončí, vrátí je zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rebase legt nicht committete Änderungen beiseite und holt sie zurück, wenn er abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rebase aparta los cambios que aún no están en ningún commit y los recupera cuando termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rebase met de côté les modifications non enregistrées par un commit et les rétablit lorsqu’il se termine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rebase mette da parte le modifiche non ancora salvate con un commit e le rimette al loro posto quando termina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リベースでは、コミットしていない変更をいったん退避し、リベースの終了時に元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리베이스할 때 커밋하지 않은 변경 사항을 따로 보관해 두었다가, 리베이스가 끝나면 다시 적용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rebase zet wijzigingen die nog niet zijn gecommit opzij en brengt ze terug als de rebase klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed operacją rebase niezatwierdzone zmiany są odkładane na bok, a po jej zakończeniu wracają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um rebase põe de lado as alterações sem commit e as traz de volta quando termina."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rebase pune deoparte modificările nesalvate prin commit și le readuce când se încheie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перебазирование откладывает незакоммиченные изменения и возвращает их, когда завершается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ombasering lägger undan ändringar som inte har checkats in och tar fram dem igen när den är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebase işlemi, commit edilmemiş değişiklikleri kenara alır ve işlem bittiğinde onları geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перебазування відкладає незафіксовані зміни й повертає їх, коли завершується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "变基会先将未提交的更改暂放一边，并在结束时将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行rebase時，會先將尚未提交的變更放到一旁，結束後再放回來。"
          }
        }
      }
    },
    "A reset keeps a copy of the settings it clears, and Put Back works from it even after the app has written new ones. A copy can hold a license key or an account, so clear the ones you no longer need." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při resetování Peel uloží kopii nastavení, která vymaže, a tlačítko Vrátit zpět z ní nastavení obnoví, i když už aplikace zapsala nová. Kopie může obsahovat licenční klíč nebo účet, proto ty, které už nepotřebujete, odstraňte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Zurücksetzen wird eine Kopie der entfernten Einstellungen aufbewahrt, und „Zurücklegen“ funktioniert damit auch dann, wenn die App bereits neue geschrieben hat. Eine Kopie kann einen Lizenzschlüssel oder einen Account enthalten, entferne also die, die du nicht mehr brauchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al restablecer una app, se guarda una copia de los ajustes que se borran, y “Restaurar” funciona a partir de ella incluso después de que la app haya escrito ajustes nuevos. Una copia puede contener una clave de licencia o una cuenta, así que elimina las que ya no necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une réinitialisation conserve une copie des réglages qu’elle efface, et « Remettre » s’en sert même après que l’app a écrit de nouveaux réglages. Une copie peut contenir une clé de licence ou un compte : supprimez donc celles dont vous n’avez plus besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una reimpostazione conserva una copia delle impostazioni che cancella, e “Ripristina” funziona a partire da quella anche dopo che l’app ne ha scritte di nuove. Una copia può contenere una chiave di licenza o un account, quindi rimuovi quelle che non ti servono più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リセットでは、消去する設定のコピーが保存され、アプリが新しい設定を書き込んだ後でも、そのコピーから“戻す”を使えます。コピーにはライセンスキーやアカウントが含まれている場合があるため、不要になったものはゴミ箱に入れてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재설정하면 지워지는 설정의 복사본이 보관되며, ‘되돌려 놓기’는 앱이 새로운 설정을 쓴 후에도 이 복사본으로 작동합니다. 복사본에는 라이센스 키나 계정이 들어 있을 수 있으므로 더 이상 필요 없는 복사본은 지우십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het opnieuw instellen wordt een kopie bewaard van de instellingen die worden gewist, en 'Zet terug' werkt daarmee, zelfs nadat de app nieuwe instellingen heeft geschreven. Een kopie kan een licentiesleutel of een account bevatten, dus ruim de kopieën op die je niet meer nodig hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyzerowanie zachowuje kopię czyszczonych ustawień, a przycisk Przywróć korzysta z niej nawet wtedy, gdy aplikacja zapisała już nowe. Kopia może zawierać klucz licencyjny lub dane konta, więc przenoś do Kosza te, których już nie potrzebujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma redefinição guarda uma cópia dos ajustes que limpa, e Colocar de Volta usa essa cópia mesmo depois que o app gravou ajustes novos. Uma cópia pode conter uma chave de licença ou uma conta, então remova as de que você não precisa mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resetare păstrează o copie a configurărilor pe care le elimină, iar butonul Puneți înapoi funcționează pe baza ei chiar și după ce aplicația a scris altele noi. O copie poate conține o cheie de licență sau un cont, așa că eliminați copiile de care nu mai aveți nevoie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При сбросе сохраняется копия очищаемых настроек, и кнопка «Восстановить» работает с ней, даже если приложение уже записало новые. В копии может быть лицензионный ключ или учетная запись, поэтому удаляйте те копии, которые Вам больше не нужны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nollställning sparar en kopia av inställningarna som den rensar, och Lägg tillbaka fungerar utifrån den även efter att appen har skrivit nya. En kopia kan innehålla en licensnyckel eller ett konto, så rensa bort de kopior som du inte längre behöver."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sıfırlama, temizlediği ayarların bir kopyasını tutar; Yerine Koy, uygulama yeni ayarlar yazdıktan sonra bile bu kopyayı kullanır. Bir kopya lisans anahtarı veya hesap bilgisi içerebilir, bu yüzden artık gerekmeyenleri temizleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скидання зберігає копію налаштувань, які очищає, і «Повернути назад» працює з цієї копії навіть після того, як програма записала нові. Копія може містити ліцензійний ключ чи дані облікового запису, тож вилучайте ті копії, які вам більше не потрібні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置时会保留一份所清除设置的副本，即使App之后写入了新设置，“放回原处”也能根据副本恢复。副本中可能包含许可证密钥或账户，因此请清除不再需要的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置時會保留一份它所清除之設定的副本，即使App已寫入新的設定，「還原」仍可依據此副本運作。副本中可能含有授權碼或帳號，因此請清除你不再需要的副本。"
          }
        }
      }
    },
    "A screenshot of a window shows the window alone, without its shadow." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snímek okna zobrazí jen samotné okno bez stínu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bildschirmfoto eines Fensters zeigt nur das Fenster, ohne seinen Schatten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura de una ventana muestra solo la ventana, sin su sombra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture d’une fenêtre montre la fenêtre seule, sans son ombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo screenshot di una finestra mostra solo la finestra, senza la sua ombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウのスクリーンショットには、影のないウインドウだけが写ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 스크린샷에 그림자 없이 윈도우만 담깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een schermafbeelding van een venster toont alleen het venster, zonder schaduw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrzut ekranu okna pokazuje samo okno, bez cienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A captura de tela de uma janela mostra só a janela, sem a sombra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura de ecran a unei ferestre arată doar fereastra, fără umbra ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На снимке окна видно только само окно, без тени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En skärmavbild av ett fönster visar bara fönstret, utan skugga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir pencerenin ekran resmi, pencereyi gölgesi olmadan tek başına gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімок вікна показує лише вікно, без його тіні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口截屏只显示窗口本身，不带阴影。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視窗截圖只會顯示視窗本身，不含陰影。"
          }
        }
      }
    },
    "A selected folder goes to the Trash with everything in it. Peel always keeps at least one, and it moves a folder only if nothing inside it has changed since the scan." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybraná složka se přesune do koše se vším, co obsahuje. Peel vždy ponechá alespoň jednu a složku přesune, jen pokud se v ní od prohledání nic nezměnilo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ausgewählter Ordner wird samt Inhalt in den Papierkorb gelegt. Peel behält immer mindestens eine Kopie und verschiebt einen Ordner nur, wenn sich seit dem Scan nichts darin geändert hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carpeta seleccionada va a la papelera con todo lo que contiene. Peel siempre conserva al menos una y solo traslada una carpeta si no ha cambiado nada dentro de ella desde el análisis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dossier sélectionné est placé dans la corbeille avec tout ce qu’il contient. Peel en conserve toujours au moins un, et ne déplace un dossier que si rien de ce qu’il contient n’a changé depuis l’analyse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cartella selezionata va nel Cestino con tutto ciò che contiene. Peel ne tiene sempre almeno una e sposta una cartella solo se al suo interno non è cambiato nulla dall’analisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダは、中身ごとゴミ箱に入ります。Peelは必ず少なくとも1つを残し、スキャン後に中身が何も変わっていないフォルダだけを移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더는 안에 있는 모든 항목과 함께 휴지통으로 이동합니다. Peel은 항상 하나 이상을 유지하며, 스캔 이후 폴더 안의 어떤 항목도 변경되지 않은 경우에만 폴더를 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een geselecteerde map gaat met alles erin naar de prullenmand. Peel behoudt altijd minstens één kopie en verplaatst een map alleen als er sinds de scan niets in is gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznaczony folder trafia do Kosza razem z całą zawartością. Peel zawsze zachowuje co najmniej jeden i przenosi folder tylko wtedy, gdy nic się w nim nie zmieniło od skanowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pasta selecionada vai para o Lixo com tudo o que há dentro dela. O Peel sempre mantém pelo menos uma e só move uma pasta se nada dentro dela tiver mudado desde a análise."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dosar selectat este mutat în Coș cu tot ce conține. Peel păstrează întotdeauna cel puțin unul și mută un dosar doar dacă nimic din el nu s‑a schimbat de la scanare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранная папка перемещается в Корзину вместе со всем содержимым. Peel всегда оставляет хотя бы одну копию и перемещает папку, только если в ней ничего не изменилось после сканирования."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En markerad mapp flyttas till papperskorgen med allt som finns i den. Peel behåller alltid minst en, och flyttar en mapp bara om inget i den har ändrats sedan skanningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili bir klasör, içindeki her şeyle birlikte Çöp Sepeti’ne gider. Peel her zaman en az birini tutar ve bir klasörü yalnızca taramadan bu yana içindeki hiçbir şey değişmediyse taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрана папка переміщується в Смітник з усім умістом. Peel завжди залишає щонайменше одну і переміщує папку, лише якщо в ній нічого не змінилося після сканування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选文件夹会连同其中的所有内容一起移到废纸篓。Peel始终至少保留一个，而且只有在扫描后文件夹中的内容没有任何变化时，才会移动该文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取的檔案夾會連同其中所有內容一起丟到「垃圾桶」。Peel一律至少保留一份，而且只有在檔案夾內容自掃描後都沒有變更時，才會移動它。"
          }
        }
      }
    },
    "A small tool with administrator rights. It moves items to the Trash, puts them back, starts or stops background items, and forgets installer receipts. It takes no other orders." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malý nástroj s oprávněními správce. Přesouvá položky do koše, vrací je zpět, spouští a zastavuje položky na pozadí a zapomíná záznamy o instalaci. Žádné jiné příkazy nepřijímá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleines Tool mit Administratorrechten. Es legt Objekte in den Papierkorb, legt sie zurück, startet oder stoppt Hintergrundobjekte und vergisst Paketquittungen. Andere Befehle nimmt es nicht an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pequeña herramienta con permisos de administrador. Traslada ítems a la papelera, los restaura, inicia o detiene ítems en segundo plano y olvida recibos de instalador. No acepta ninguna otra orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit outil doté des droits d’administrateur. Il place des éléments dans la corbeille, les remet en place, démarre ou arrête des éléments en arrière-plan, et oublie des reçus d’installation. Il n’accepte aucun autre ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un piccolo strumento con privilegi di amministratore. Sposta elementi nel Cestino, li ripristina, avvia o interrompe elementi in background e dimentica le ricevute di installazione. Non accetta altri ordini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者権限を持つ小さなツールです。項目をゴミ箱に入れたり戻したりするほか、バックグラウンド項目の開始と停止、インストーラレシートのゴミ箱への移動を行います。それ以外の命令は受け付けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자 권한을 가진 작은 도구입니다. 항목을 휴지통으로 이동하고, 되돌려 놓고, 백그라운드 항목을 시작하거나 중단하고, 설치 수신 정보를 제거합니다. 그 외의 명령은 받지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een klein hulpprogramma met beheerdersrechten. Het verplaatst onderdelen naar de prullenmand, zet ze terug, start of stopt achtergrondonderdelen en vergeet installatiebewijzen. Andere opdrachten voert het niet uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Małe narzędzie z uprawnieniami administratora. Przenosi rzeczy do Kosza, przywraca je, uruchamia i zatrzymuje rzeczy działające w tle oraz zapomina potwierdzenia instalacji. Nie przyjmuje żadnych innych poleceń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pequena ferramenta com direitos de administrador. Ela move itens para o Lixo, coloca-os de volta, inicia ou para itens em segundo plano e esquece recibos de instalação. Ela não aceita nenhuma outra ordem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mic instrument cu drepturi de administrator. Mută articole în Coș, le pune înapoi, pornește sau oprește articole de fundal și uită recipise de instalare. Nu primește alte comenzi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Небольшая программа с правами администратора. Она перемещает объекты в Корзину, восстанавливает их, запускает и останавливает фоновые объекты и забывает квитанции установщика. Других команд она не выполняет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett litet verktyg med administratörsbehörighet. Det flyttar objekt till papperskorgen, lägger tillbaka dem, startar eller stoppar bakgrundsobjekt och glömmer installationskvitton. Det tar inte emot några andra kommandon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici haklarına sahip küçük bir araç. Öğeleri Çöp Sepeti’ne taşır, yerine koyar, arka plan öğelerini başlatır veya durdurur ve yükleyici makbuzlarını unutur. Başka hiçbir komut almaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невеликий інструмент із правами адміністратора. Він переміщує елементи в Смітник, повертає їх назад, запускає чи зупиняє фонові елементи й забуває квитанції інсталяторів. Інших команд він не виконує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个拥有管理员权限的小工具。它会将项目移到废纸篓、将其放回原处、启动或停止后台项目，以及移除安装器回执。它不接受任何其他指令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個擁有管理者權限的小工具。它會將項目丟到「垃圾桶」、還原項目、啟動或停止背景項目，以及移除安裝收據。它不接受其他任何指令。"
          }
        }
      }
    },

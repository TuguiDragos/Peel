{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "shouldTranslate" : false
    },
    "NSAppDataUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel nahlíží do vlastního kontejneru aplikace, aby zjistil, co by po sobě zanechala. Dokud k tomu nedáte pokyn, nic se neodstraní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel sieht in den eigenen Container einer App, um aufzulisten, was sie hinterlassen würde. Ohne deine Zustimmung wird nichts entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peel looks inside an app’s own container to list what it would leave behind. Nothing is removed until you say so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel mira dentro del propio contenedor de una app para mostrar lo que dejaría. No se elimina nada hasta que tú lo digas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel examine le conteneur propre à une app pour lister ce qu’elle laisserait derrière elle. Rien n’est supprimé tant que vous ne l’avez pas demandé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel guarda nel contenitore di un’app per elencare ciò che si lascerebbe dietro. Non viene rimosso nulla finché non lo dici tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peelは、アプリが残すものを一覧表示するために、そのアプリのコンテナ内を調べます。指示するまで、何もゴミ箱に入れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel은 앱이 남기게 될 항목을 나열하기 위해 앱 자체의 컨테이너 안을 살펴봅니다. 사용자가 요청하기 전에는 아무것도 제거되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel kijkt in de eigen container van een app om te tonen wat die zou achterlaten. Er wordt niets verwijderd totdat jij dat zegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel zagląda do własnego kontenera aplikacji, aby wyświetlić, co by po sobie pozostawiła. Nic nie trafi do Kosza, dopóki o tym nie zdecydujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peel examina o próprio contêiner de um app para listar o que ele deixaria para trás. Nada é removido até você pedir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel caută în containerul propriu al unei aplicații pentru a lista ce ar lăsa în urmă. Nu se elimină nimic până nu cereți dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel заглядывает в собственный контейнер приложения, чтобы показать, что после него останется. Ничего не удаляется без Вашего решения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel tittar i en apps egen behållare för att lista vad appen skulle lämna kvar. Inget tas bort förrän du säger till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel, bir uygulamanın geride bırakacaklarını listelemek için o uygulamanın kendi kapsayıcısının içine bakar. Siz söyleyene kadar hiçbir şey kaldırılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel зазирає у власний контейнер програми, щоб показати, що вона залишила б по собі. Нічого не вилучається, доки ви не скажете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel会查看App自己的容器，以列出它会留下的文件。在你确认之前，不会移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel會查看App自己的容器，以列出它會留下的檔案。在你下達指示之前，不會移除任何項目。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel tuto složku čte, když se do ní podívá některý z jeho nástrojů nebo když otevřete aplikaci, která je v ní uložená. Nic se neodstraní, dokud o tom sami nerozhodnete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel liest diesen Ordner, wenn eines seiner Tools hier nachsieht oder wenn du eine App öffnest, die hier liegt. Ohne deine Zustimmung wird nichts entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peel reads this folder when one of its tools looks here or when you open an app that is kept here. Nothing is removed until you say so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel lee esta carpeta cuando una de sus herramientas busca aquí o cuando abres una app que se guarda aquí. No se elimina nada hasta que tú lo digas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel lit ce dossier lorsque l’un de ses outils l’examine ou lorsque vous ouvrez une app qui s’y trouve. Rien n’est supprimé sans votre accord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel legge questa cartella quando uno dei suoi strumenti la esamina o quando apri un’app che si trova qui. Nulla viene rimosso finché non lo decidi tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peelは、いずれかのツールでここを調べるとき、またはここに保管されているアプリを開くときに、このフォルダを読み取ります。指示するまで、何もゴミ箱に入れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel은 자체 도구 중 하나가 이곳을 살펴보거나 사용자가 Peel에서 이곳에 있는 앱을 열 때 이 폴더를 읽습니다. 사용자가 요청하기 전에는 아무것도 제거되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel leest deze map als een van de tools van Peel hier kijkt of als je een app opent die hier staat. Er wordt niets verwijderd totdat jij dat zegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel odczytuje ten folder, gdy któreś z jego narzędzi tu zagląda lub gdy otwierasz aplikację, która jest tu przechowywana. Nic nie trafi do Kosza, dopóki o tym nie zdecydujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peel lê esta pasta quando uma das ferramentas dele procura algo aqui ou quando você abre um app que fica aqui. Nada é removido até que você peça."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel citește acest dosar când unul dintre instrumentele sale caută aici sau când deschideți o aplicație care se află aici. Nu se elimină nimic până nu cereți dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel читает эту папку, когда сюда заглядывает один из его инструментов или когда Вы открываете в Peel приложение, которое хранится здесь. Ничего не удаляется без Вашего решения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel läser den här mappen när ett av Peels verktyg tittar här eller när du öppnar en app som ligger här. Inget tas bort förrän du säger till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel, araçlarından biri buraya baktığında veya burada tutulan bir uygulamayı açtığınızda bu klasörü okur. Siz söylemedikçe hiçbir şey kaldırılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel читає цю папку, коли один з її інструментів шукає тут або коли ви відкриваєте програму, яка тут зберігається. Нічого не вилучається, доки ви не скажете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当Peel的某个工具查看此处，或你打开存放在此处的App时，Peel会读取此文件夹。未经你同意，不会移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當Peel的某個工具查看此處，或當你打開存放在此處的App時，Peel會讀取此檔案夾。在你決定之前，不會移除任何項目。"
          }
        }
      }
    },

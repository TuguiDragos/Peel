{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "shouldTranslate" : false
    },
    "NSAppDataUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel nahlíží do vlastního kontejneru aplikace, aby zjistil, co by po sobě zanechala. Dokud k tomu nedáte pokyn, nic se neodstraní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel sieht in den eigenen Container einer App, um aufzulisten, was sie hinterlassen würde. Nichts wird entfernt, bevor du es sagst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peel looks inside an app’s own container to list what it would leave behind. Nothing is removed until you say so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel mira dentro del propio contenedor de una app para mostrar lo que dejaría. No se elimina nada hasta que tú lo digas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel examine le conteneur propre à une app pour lister ce qu’elle laisserait derrière elle. Rien n’est supprimé tant que vous ne l’avez pas demandé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel guarda nel contenitore di un’app per elencare ciò che si lascerebbe dietro. Non viene rimosso nulla finché non lo dici tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peelは、アプリが残すものを一覧表示するために、そのアプリのコンテナ内を調べます。指示するまで、何もゴミ箱に入れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel은 앱이 남기게 될 항목을 나열하기 위해 앱 자체의 컨테이너 안을 살펴봅니다. 사용자가 요청하기 전에는 아무것도 제거되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel kijkt in de eigen container van een app om te tonen wat die zou achterlaten. Er wordt niets verwijderd totdat jij dat zegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel zagląda do własnego kontenera aplikacji, aby wyświetlić, co by po sobie pozostawiła. Nic nie trafi do Kosza, dopóki o tym nie zdecydujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peel examina o próprio contêiner de um app para listar o que ele deixaria para trás. Nada é removido até você pedir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel caută în containerul propriu al unei aplicații pentru a lista ce ar lăsa în urmă. Nu se elimină nimic până nu cereți dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel заглядывает в собственный контейнер приложения, чтобы показать, что после него останется. Ничего не удаляется без Вашего решения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel tittar i en apps egen behållare för att lista vad appen skulle lämna kvar. Inget tas bort förrän du säger till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel, bir uygulamanın geride bırakacaklarını listelemek için o uygulamanın kendi kapsayıcısının içine bakar. Siz söyleyene kadar hiçbir şey kaldırılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel зазирає у власний контейнер програми, щоб показати, що вона залишила б по собі. Нічого не вилучається, доки ви не скажете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel会查看App自己的容器，以列出它会留下的文件。在你确认之前，不会移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel會查看App自己的容器，以列出它會留下的檔案。在你下達指示之前，不會移除任何項目。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel tu hledá instalátory a duplicitní soubory. Dokud k tomu nedáte pokyn, nic se neodstraní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel sucht hier nach Installern und doppelten Dateien. Nichts wird entfernt, bevor du es sagst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peel looks here for installers and duplicate files. Nothing is removed until you say so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel busca aquí instaladores y archivos duplicados. No se elimina nada hasta que tú lo digas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel recherche ici des programmes d’installation et des fichiers en double. Rien n’est supprimé tant que vous ne l’avez pas demandé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel cerca qui installer e file duplicati. Non viene rimosso nulla finché non lo dici tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peelはここでインストーラや重複ファイルを探します。指示するまで、何もゴミ箱に入れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel은 이곳에서 설치 프로그램과 중복된 파일을 찾습니다. 사용자가 요청하기 전에는 아무것도 제거되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel zoekt hier naar installatieprogramma's en dubbele bestanden. Er wordt niets verwijderd totdat jij dat zegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel szuka tutaj instalatorów i zduplikowanych plików. Nic nie trafi do Kosza, dopóki o tym nie zdecydujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peel procura aqui instaladores e arquivos duplicados. Nada é removido até você pedir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel caută aici programe de instalare și fișiere duplicate. Nu se elimină nimic până nu cereți dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel ищет здесь установщики и дубликаты файлов. Ничего не удаляется без Вашего решения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel letar här efter installerare och dubblettfiler. Inget tas bort förrän du säger till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel burada yükleyicileri ve yinelenen dosyaları arar. Siz söyleyene kadar hiçbir şey kaldırılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel шукає тут інсталятори й файли-дублікати. Нічого не вилучається, доки ви не скажете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel会在这里查找安装器和重复文件。在你确认之前，不会移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel會在這裡尋找安裝程式和重複的檔案。在你下達指示之前，不會移除任何項目。"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel tu hledá instalátory, duplicitní soubory a to, co zbylo po sestavení. Dokud k tomu nedáte pokyn, nic se neodstraní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel sucht hier nach Installern, doppelten Dateien und dem, was Builds hinterlassen haben. Nichts wird entfernt, bevor du es sagst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peel looks here for installers, duplicate files, and what builds left behind. Nothing is removed until you say so."

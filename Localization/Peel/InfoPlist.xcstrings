        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel zoekt hier naar installatieprogramma's, dubbele bestanden en wat builds hebben achtergelaten. Er wordt niets verwijderd totdat jij dat zegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel szuka tutaj instalatorów, zduplikowanych plików i tego, co pozostawiły kompilacje. Nic nie trafi do Kosza, dopóki o tym nie zdecydujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Peel procura aqui instaladores, arquivos duplicados e o que as compilações deixaram para trás. Nada é removido até você pedir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel caută aici programe de instalare, fișiere duplicate și ce au lăsat în urmă compilările. Nu se elimină nimic până nu cereți dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel ищет здесь установщики, дубликаты файлов и то, что осталось после сборок. Ничего не удаляется без Вашего решения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel letar här efter installerare, dubblettfiler och det som byggen har lämnat kvar. Inget tas bort förrän du säger till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel burada yükleyicileri, yinelenen dosyaları ve derlemelerin geride bıraktıklarını arar. Siz söyleyene kadar hiçbir şey kaldırılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel шукає тут інсталятори, файли-дублікати й те, що залишили по собі збірки. Нічого не вилучається, доки ви не скажете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel会在这里查找安装器、重复文件以及构建留下的内容。在你确认之前，不会移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peel會在這裡尋找安裝程式、重複的檔案，以及建置留下的項目。在你下達指示之前，不會移除任何項目。"
          }
        }
      }
    },
